<UserControl
    x:Class="Sg.App.RevisionComparison"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App"
    HorizontalContentAlignment="Stretch" Visibility="Collapsed">
    <StackPanel Spacing="8">
        <TextBlock Text="SVN revisions" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <TextBlock x:Name="ComparisonSummary" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
        <local:ReadFeedback x:Name="Reading" StateId="RevisionComparisonLoading" />
        <InfoBar x:Name="ReadError" Title="Could not compare SVN revisions" Severity="Error" IsClosable="False" IsOpen="False">
            <local:IconButton x:Name="RetryComparison" Text="Retry comparison" Glyph="&#xE72C;" Click="Retry_Click" />
        </InfoBar>
        <InfoBar x:Name="DriftBar" Title="The destination differs from the saved version" Severity="Warning" IsClosable="False" IsOpen="False" />
        <Border x:Name="BasesCard" Style="{StaticResource Card}" Padding="4">
            <local:RowListView x:Name="Bases" SelectionMode="None">
                <local:RowListView.ItemTemplate>
                    <DataTemplate x:DataType="local:RevisionComparisonRow">
                        <StackPanel Spacing="4" ToolTipService.ToolTip="{x:Bind Url}">
                            <TextBlock Text="{x:Bind Where}" Style="{StaticResource RowText}" TextWrapping="Wrap" />
                            <local:WrapRow Spacing="12">
                                <TextBlock Text="{x:Bind Saved}" Style="{StaticResource RowMonoDim}" />
                                <FontIcon Glyph="&#xE72A;" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Local}" Style="{StaticResource RowMono}" Foreground="{x:Bind LocalBrush}" />
                            </local:WrapRow>
                            <TextBlock Text="{x:Bind Url}" Style="{StaticResource RowTextDim}" />
                        </StackPanel>
                    </DataTemplate>
                </local:RowListView.ItemTemplate>
            </local:RowListView>
        </Border>
    </StackPanel>
</UserControl>
