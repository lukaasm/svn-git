<local:SgPage
    x:Class="Sg.App.ConflictPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App">
    <Grid RowDefinitions="*,Auto,Auto">

        <!-- No file in conflict means no list, no sides to pick and no diff: the page is the one
             sentence about what stopped, and the buttons that move it on. -->
        <local:EmptyState x:Name="NoConflicts" Grid.Row="0" Visibility="Collapsed" Glyph="&#xE73E;" Title="Nothing in conflict" />

        <Grid x:Name="Filled" Grid.Row="0" RowDefinitions="Auto,*,Auto">
            <StackPanel Grid.Row="0" Spacing="6">
                <InfoBar x:Name="StateBar" Severity="Warning" IsClosable="False" IsOpen="True" />
                <TextBlock x:Name="Explanation" TextWrapping="Wrap" />
            </StackPanel>

            <Grid x:Name="Body" Grid.Row="1" Padding="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftCol" Width="560" MinWidth="320" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock x:Name="FilesHeader" Text="Files in conflict" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBox x:Name="Filter" Grid.Column="1" PlaceholderText="Filter files  (Ctrl+F)" Visibility="Collapsed" FontSize="12" MinWidth="200"
                                 ToolTipService.ToolTip="Show only the rows whose path contains this text." />
                    </Grid>
                    <!-- Which two versions these are depends on what stopped, so both buttons are named
                         from the page rather than written here. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <local:IconButton x:Name="TakeOurs" Glyph="&#xE753;" Text="Keep this side" Click="TakeOurs_Click" />
                        <local:IconButton x:Name="TakeTheirs" Glyph="&#xE8A5;" Text="Keep that side" Click="TakeTheirs_Click" />
                        <local:IconButton Glyph="&#xE70F;" Text="Edit"
                            Click="OpenFile_Click" ToolTipService.ToolTip="Open the ticked files in their default editor. Each holds both versions between conflict markers. Edit it, save, then mark it resolved." />
                        <local:IconButton Glyph="&#xE73E;" Text="Mark resolved"
                            Click="MarkResolved_Click" ToolTipService.ToolTip="Tell git the ticked files are done, after you edited them by hand." />
                        <local:IconButton x:Name="AutoButton" Glyph="&#xE945;" Text="Resolve with AI"
                            Click="Auto_Click" ToolTipService.ToolTip="Hand the ticked files, or every file in conflict, to the resolver: Claude Code, unless Settings names another command. It edits them in place, keeping both sides' changes. What comes back whole is marked resolved and stays here to read before you continue." />
                    </StackPanel>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
                        <Grid>
                            <!-- Tick the files a side applies to. A tree has nowhere to drag a selection across,
                                 and a folder's box picks a side for everything under it in one click. -->
                            <local:RowTreeView x:Name="Files" ItemTemplate="{StaticResource CheckedFileTreeTemplate}" />
                            <local:Skeleton x:Name="FilesSkeleton" RowCount="5" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>

                <Thumb x:Name="Splitter" Grid.Column="1" Style="{StaticResource Splitter}" />

                <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="6">
                    <!-- Two versions side by side say what differs, not who changed it. The other two
                         pairs show each side against what both started from, which is what a hand needs
                         before it can carry one change over onto the other. -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Compare" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <ComboBox x:Name="Compare" MinWidth="300" SelectedIndex="0" SelectionChanged="Compare_Changed" FontSize="12"
                                  ToolTipService.ToolTip="Which two versions of the picked file the diff shows." />
                    </StackPanel>
                    <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <local:DiffView x:Name="Diff" Margin="1" />
                    </Border>
                </Grid>
            </Grid>

        </Grid>

        <local:DiffView x:Name="PatchPreview" Grid.Row="0" Visibility="Collapsed" />

            <StackPanel x:Name="Actions" Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <local:IconButton x:Name="ReviewEditsButton" Glyph="&#xE8A5;" Text="Review local edits" Visibility="Collapsed" Click="ReviewEdits_Click" />
                <local:IconButton x:Name="ReviewResultButton" Glyph="&#xE8A5;" Text="Review staged result" Click="ReviewResult_Click" />
                <local:IconButton x:Name="InspectButton" Glyph="&#xE8A5;" Text="View current patch" Click="Inspect_Click" />
                <local:IconButton x:Name="ContinueButton" Glyph="&#xE768;" Text="Continue"
                    Style="{StaticResource AccentButtonStyle}" Click="Continue_Click"
                    ToolTipService.ToolTip="Go on. Works when no file is in conflict any more. The next commit may stop again." />
                <local:IconButton x:Name="SkipButton" Glyph="&#xE72A;" Text="Skip this one"
                    Click="Skip_Click" ToolTipService.ToolTip="Drop the commit this stopped on and go on with the ones after it. Asks first." />
                <local:IconButton x:Name="AbortButton" Glyph="&#xE711;" Text="Abort"
                    Click="Abort_Click" ToolTipService.ToolTip="Stop and put the branch back. Asks first, and says what it costs." />
                <Button Content="More">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="AutoAllButton" Text="Resolve remaining commits with AI" Click="AutoAll_Click" />
                            <MenuFlyoutItem x:Name="ForceButton" Text="Apply patch manually…" Visibility="Collapsed" Click="Force_Click" />
                            <MenuFlyoutItem Text="Refresh" Click="Refresh_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="LeaveButton" Content="Finish later" Click="Close_Click" ToolTipService.ToolTip="Back to where you came from. What stopped stays where it is." />
            </StackPanel>

        <local:StatusStrip x:Name="Pane" Grid.Row="2" Margin="0,8,0,0" />
    </Grid>
</local:SgPage>
