<UserControl
    x:Class="Sg.App.PathPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A list of paths inside the checkout. The folders that are actually there are offered by name,
         so the usual case is picking rather than typing one and finding out later it was wrong. The
         box below stays editable: a path that is not on disk yet is still a legitimate answer. -->
    <StackPanel Spacing="6">
        <TextBlock x:Name="HeaderText" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ComboBox x:Name="Candidates" HorizontalAlignment="Stretch" PlaceholderText="folders in this checkout"
                      ToolTipService.ToolTip="The folders sg found in the checkout, one and two levels down." />
            <Button x:Name="AddButton" Grid.Column="1" Click="Add_Click" IsEnabled="False"
                    ToolTipService.ToolTip="Put the chosen folder in the list below.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                    <TextBlock Text="Add" />
                </StackPanel>
            </Button>
        </Grid>
        <TextBox x:Name="Box" AcceptsReturn="True" Height="70" TextWrapping="NoWrap"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
    </StackPanel>
</UserControl>
