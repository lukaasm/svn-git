<UserControl
    x:Class="Sg.App.BackupStatusView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App">
    <Border Style="{StaticResource Card}">
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <local:StatusChip x:Name="ScheduleChip" Glyph="&#xE823;" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Next automatic backup" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="NextRun" AutomationProperties.AutomationId="BackupNextRun"
                               Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <local:StatusChip x:Name="SuccessChip" Glyph="&#xE74E;" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Last successful backup" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="LastSuccess" AutomationProperties.AutomationId="BackupLastSuccess"
                               Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Keep the overview open or running in the tray. Busy intervals are skipped."
                       Style="{StaticResource Secondary}" TextWrapping="Wrap" />
            <InfoBar x:Name="SkippedNotice" Title="Last interval skipped" Severity="Warning" IsOpen="False" IsClosable="False">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="SkippedReason" AutomationProperties.AutomationId="BackupSkippedReason" TextWrapping="Wrap" />
                    <local:IconButton x:Name="BlockingTask" AutomationProperties.AutomationId="BackupBlockingTask"
                                      Text="View blocking task" Glyph="&#xE8A5;" HorizontalAlignment="Left" Click="BlockingTask_Click" />
                </StackPanel>
            </InfoBar>
        </StackPanel>
    </Border>
</UserControl>
