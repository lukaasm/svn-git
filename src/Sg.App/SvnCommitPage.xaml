<local:SgPage
    x:Class="Sg.App.SvnCommitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Above both states: a commit that just went through empties the page, and its result must outlive that. -->
        <InfoBar x:Name="ResultBar" Grid.Row="0" Severity="Success" IsClosable="True" IsOpen="False" Margin="0,0,0,8" />

        <!-- Unknown inventory has no promised table shape. Keep a compact loader in the same body
             as the empty/result state, and retain the current body on subsequent refreshes. -->
        <local:ReadFeedback x:Name="InitialLoading" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" />
        <ProgressBar x:Name="RefreshProgress" Grid.Row="1" VerticalAlignment="Top" Height="3" Canvas.ZIndex="1" Visibility="Collapsed" />

        <!-- A clean checkout has no list to pick from, no diff to read and no message to write, so none of
             that is on screen: the page is the one sentence, and the two buttons that still mean something. -->
        <local:EmptyState x:Name="Clean" Grid.Row="1" Visibility="Collapsed" Glyph="&#xE73E;" Title="The checkout is clean"
                          Text="Nothing is edited directly in the checkout. Work that belongs to a branch lives in its worktree.">
            <local:EmptyState.Action>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <local:IconButton Glyph="&#xE72C;" Text="Refresh" Click="Refresh_Click" ToolTipService.ToolTip="Read the changes in the checkout again." />
                    <local:IconButton x:Name="CleanShelfButton" Glyph="&#xE7B8;" Text="Shelved changes" Click="Shelf_Click" Visibility="Collapsed"
                                      ToolTipService.ToolTip="Changes put aside from this checkout. The checkout is clean because they are waiting here." />
                    <Button Content="Close" Click="Close_Click" ToolTipService.ToolTip="Back to where you came from." />
                </StackPanel>
            </local:EmptyState.Action>
        </local:EmptyState>

        <ContentControl x:Name="FilledGate" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False">
        <Grid x:Name="Filled" RowDefinitions="Auto,*,Auto" Visibility="Collapsed">
            <!-- It explains the page; it is not a status, so it can be closed. -->
            <InfoBar x:Name="InfoText" Grid.Row="0" Severity="Informational" IsClosable="True" IsOpen="True"
                     Message="These are edits made directly in the SVN checkout. Commit sends the checked ones straight to SVN, one commit per working copy. Then the snapshot is refreshed." />

            <Grid x:Name="Body" Grid.Row="1" Padding="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftCol" Width="560" MinWidth="320" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="6">
                    <!-- The filter takes what the header leaves. Discard and Shelve are in the menu of Commit:
                         the three ends of one decision about the same checked files. -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock x:Name="FilesHeader" Text="Changes" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBox x:Name="Filter" Grid.Column="1" PlaceholderText="Filter files  (Ctrl+F)" Visibility="Collapsed" FontSize="12" VerticalAlignment="Center"
                                 ToolTipService.ToolTip="Show only the rows whose status or path contains this text. It changes the list, never what is checked or discarded." />
                        <!-- One box for every row: ticked when they all are, half when some are. -->
                        <CheckBox x:Name="AllCheck" Grid.Column="2" Content="All" MinWidth="0" Click="All_Click"
                                  ToolTipService.ToolTip="Check every change, unversioned files too. With every change checked, this unchecks them all." />
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                        <Grid>
                            <!-- One root per working copy: a commit goes out per working copy, so the tree shows the same cut. -->
                            <local:RowTreeView x:Name="Files" ItemTemplate="{StaticResource CheckedFileTreeTemplate}" />
                            <local:Skeleton x:Name="FilesSkeleton" RowCount="8" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>

                <Thumb x:Name="Splitter" Grid.Column="1" Style="{StaticResource Splitter}" />

                <Border Grid.Column="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <local:DiffView x:Name="Diff" Margin="1" />
                </Border>
            </Grid>

            <!-- The message is asked for on the press, in a dialog, not held open under the list. -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                <CommandBar x:Name="Actions" DefaultLabelPosition="Right" Background="Transparent" HorizontalAlignment="Left" Margin="-8,0,0,0">
                    <AppBarButton Label="Refresh" Click="Refresh_Click" ToolTipService.ToolTip="Read the changes in the checkout again. F5 does the same.">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <CommandBar.SecondaryCommands>
                        <AppBarButton x:Name="ShelfButton" Label="Shelved changes" Click="Shelf_Click"
                                      ToolTipService.ToolTip="What is already put aside from this checkout, and the button that writes it back.">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE7B8;" /></AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.SecondaryCommands>
                </CommandBar>
                <TextBlock Grid.Column="1" x:Name="Summary" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <!-- The same split the git changes page has, and for the same reason: the three ends of one
                     decision about the same checked files. Here putting them aside is also how a push that
                     refuses because the checkout holds an edit on the same file gets unblocked. -->
                <local:TaskGate Grid.Column="2">
                    <local:AccentSplitButton AutomationProperties.Name="Commit to SVN" x:Name="CommitButton"
                                             Click="Commit_Click"
                                             ToolTipService.ToolTip="Write the message, then commit the checked changes to SVN, one commit per working copy. Unversioned files are added first. Asks first. Ctrl+Enter opens this too.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE898;" FontSize="14" />
                            <TextBlock x:Name="CommitLabel" Text="Commit to SVN" />
                        </StackPanel>
                        <local:AccentSplitButton.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedRight" local:MenuGate.Watch="True">
                                <MenuFlyoutItem Text="Copy or move to worktree…" Click="Transfer_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Shelve them instead" Click="Shelve_Click" local:MenuGate.Gated="True"
                                                ToolTipService.ToolTip="Take the checked changes out of the checkout and keep them, to put back later. This is how a local edit stops blocking a push that wants to write the same file.">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7B8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="DiscardButton" Text="Discard them…" Click="Revert_Click" local:MenuGate.Gated="True"
                                                ToolTipService.ToolTip="Put the checked files back the way SVN has them; unversioned files get deleted. The confirmation keeps a recovery shelf by default, with an option to discard permanently.">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7A7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </local:AccentSplitButton.Flyout>
                    </local:AccentSplitButton>
                </local:TaskGate>
            </Grid>
        </Grid>

        </ContentControl>
        <!-- The message, asked for in a dialog over the middle of the window. Cancel keeps the text for the next time. -->
        <local:MessageDialog x:Name="Message" Title="Commit to SVN" PrimaryButtonText="Commit to SVN"
                             Header="Commit message for SVN" CountTip="The server refuses a shorter message. The minimum is in Settings." />

        <local:StatusStrip x:Name="Pane" Grid.Row="2" Margin="0,8,0,0" />
    </Grid>
</local:SgPage>
