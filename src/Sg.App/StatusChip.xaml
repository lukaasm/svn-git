<UserControl
    x:Class="Sg.App.StatusChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    VerticalAlignment="Center">
    <Border x:Name="Pill" CornerRadius="10" Padding="6,1" Background="{x:Null}">
        <StackPanel Orientation="Horizontal" Spacing="5">
            <FontIcon x:Name="Icon" FontSize="{StaticResource RowIconSize}" VerticalAlignment="Center" />
            <TextBlock x:Name="CountText" FontSize="{StaticResource RowFontSize}" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBlock x:Name="Label" FontSize="{StaticResource RowFontSize}" VerticalAlignment="Center" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
