<UserControl
    x:Class="Sg.App.StatusStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- One row. What this window's operation is doing, how far along, and how to stop it. The lines
         themselves live in one window for the whole app, a Log button away in every title bar, because
         a console welded into every footer cost a fifth of the overview to say nothing between operations. -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto">
        <TextBlock x:Name="StatusText" Style="{StaticResource Secondary}" TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <Button AutomationProperties.Name="Cancel" x:Name="CancelButton" Grid.Column="1" Visibility="Collapsed" Click="Cancel_Click"
                Padding="8,2" MinHeight="0" FontSize="12"
                ToolTipService.ToolTip="Stop this operation. The running git or svn command is ended; nothing half written is left behind.">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
                <TextBlock Text="Cancel" />
            </StackPanel>
        </Button>
        <ProgressBar x:Name="Bar" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,6,0,0" />
    </Grid>
</UserControl>
