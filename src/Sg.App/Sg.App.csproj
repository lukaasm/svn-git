<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Sg.App</RootNamespace>
    <AssemblyName>sg-ui</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationIcon>Assets\sg.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sg.Core\Sg.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The Windows App SDK's self-contained layout leaves one file out:
    Microsoft.WindowsAppRuntime.Insights.Resource.dll. Without it next to the exe,
    AppNotificationManager.Register throws "unable to load resource dll" and every toast the app
    ever sends is dropped in silence. It is not in any lib or runtimes folder, but it does ship
    inside the runtime package's own MSIX, so take it from there rather than from the framework
    installed on the build machine.
  -->
  <Target Name="ExtractAppRuntimeInsights" Condition="'$(WindowsAppSDKSelfContained)' == 'true'">
    <ItemGroup>
      <_AppRuntimeMsix Include="$(NuGetPackageRoot)microsoft.windowsappsdk.runtime\**\tools\MSIX\win10-x64\Microsoft.WindowsAppRuntime.2.msix" />
    </ItemGroup>
    <Unzip SourceFiles="@(_AppRuntimeMsix)" DestinationFolder="$(IntermediateOutputPath)appruntime"
           Include="Microsoft.WindowsAppRuntime.Insights.Resource.dll" SkipUnchangedFiles="true"
           Condition="'@(_AppRuntimeMsix)' != ''" />
    <ItemGroup>
      <_InsightsResource Include="$(IntermediateOutputPath)appruntime\Microsoft.WindowsAppRuntime.Insights.Resource.dll" />
    </ItemGroup>
    <Warning Text="Microsoft.WindowsAppRuntime.Insights.Resource.dll was not found in the runtime package. Toast notifications will not register."
             Condition="'@(_InsightsResource)' == ''" />
  </Target>

  <Target Name="CopyAppRuntimeInsightsToOutput" AfterTargets="Build" DependsOnTargets="ExtractAppRuntimeInsights"
          Condition="'$(WindowsAppSDKSelfContained)' == 'true'">
    <Copy SourceFiles="@(_InsightsResource)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(_InsightsResource)' != ''" />
  </Target>

  <Target Name="CopyAppRuntimeInsightsToPublish" AfterTargets="Publish" DependsOnTargets="ExtractAppRuntimeInsights"
          Condition="'$(WindowsAppSDKSelfContained)' == 'true'">
    <Copy SourceFiles="@(_InsightsResource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'@(_InsightsResource)' != ''" />
  </Target>

</Project>
