<local:SgPage
    x:Class="Sg.App.ServerBranchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <StackPanel Grid.Row="0" Spacing="10">
            <!-- One line; the whole of what it does is a hover away, and the plan spells it out. -->
            <TextBlock x:Name="Intro" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"
                       Text="Copies the branch on the server, one revision per repository, and rewrites every svn:externals." />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBox x:Name="NameBox" Header="Branch name" Width="240" PlaceholderText="rel-1" TextChanged="Name_TextChanged" />
                <ComboBox x:Name="FromBox" Header="From checkout" Width="220" SelectionChanged="From_SelectionChanged" />
            </StackPanel>
            <!-- The message has a default every branch gets; a written one is said in the header. -->
            <Expander x:Name="Options" Width="472" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Branch options">
                <Expander.Header>
                    <local:WrapRow Spacing="12" LineSpacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE713;" FontSize="16" /><TextBlock Text="Options" /></StackPanel>
                        <TextBlock x:Name="OptionsNotice" Style="{StaticResource Secondary}" Text="custom message" Visibility="Collapsed" VerticalAlignment="Center" />
                    </local:WrapRow>
                </Expander.Header>
                <TextBox x:Name="MessageBox" Header="Commit message" PlaceholderText="- Creating branch: name" TextChanged="Message_TextChanged" />
            </Expander>
            <!-- The accent moves with the state: Dry run until there is a plan, then Create. -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <local:IconButton x:Name="DryRunButton" Glyph="&#xE9D9;" Text="Dry run" Style="{StaticResource AccentButtonStyle}"
                    Click="DryRun_Click" ToolTipService.ToolTip="Work out the plan and show it below. Reads from the server, changes nothing." />
                <local:TaskGate>
                    <local:AccentSplitButton x:Name="CreateButton" Click="Create_Click" IsEnabled="False" AutomationProperties.Name="Create the branch and check it out"
                        ToolTipService.ToolTip="Run the plan: one revision per repository on the server, everyone sees them. Then make the checkout. Asks first. Needs a dry run first.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE753;" FontSize="14" />
                            <TextBlock Text="Create the branch and check it out" />
                        </StackPanel>
                        <local:AccentSplitButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft" local:MenuGate.Watch="True">
                                <MenuFlyoutItem x:Name="NoCheckout" Text="Create branch only" Click="CreateBranchOnly_Click" local:MenuGate.Gated="True"
                                                ToolTipService.ToolTip="Make the branch on the server but no local checkout. You can add one later with New server checkout.">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE753;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </local:AccentSplitButton.Flyout>
                    </local:AccentSplitButton>
                </local:TaskGate>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="560" MinWidth="360" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- One card per external: the folder it lands in, where it points now, and what the new branch
                 does with it. The switch off means kept: no copy, and the line that brings it in stays. -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="6">
                <TextBlock x:Name="PartsHeader" Text="Externals" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Parts">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:BranchPartRow">
                                    <controls:SettingsCard Header="{x:Bind Wc}" Margin="0,0,0,4" IsEnabled="{x:Bind Free, Mode=OneWay}">
                                        <controls:SettingsCard.HeaderIcon>
                                            <FontIcon Glyph="&#xE8B7;" />
                                        </controls:SettingsCard.HeaderIcon>
                                        <!-- One line, not four. A card's description wraps, and six monorepo externals
                                             each wrapped their URL over four lines: the list scrolled before it said
                                             anything. The whole URL is a hover away. -->
                                        <controls:SettingsCard.Description>
                                            <TextBlock Text="{x:Bind Url}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind Url}" />
                                        </controls:SettingsCard.Description>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBox Text="{Binding Branch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{x:Bind Placeholder, Mode=OneWay}"
                                                     Width="170" FontSize="12" Visibility="{x:Bind NameVisibility, Mode=OneWay}"
                                                     ToolTipService.ToolTip="The branch this external gets. Empty means the same name as the whole." />
                                            <ToggleSwitch IsOn="{x:Bind Branched, Mode=TwoWay}" OnContent="Branch it" OffContent="Keep as is" MinWidth="0" FontSize="12"
                                                          ToolTipService.ToolTip="On: copy this external to the new branch. Off: no copy, the new branch keeps pointing where this one points now. An external inside a kept one is kept with it." />
                                        </StackPanel>
                                    </controls:SettingsCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <local:Skeleton x:Name="PartsSkeleton" RowCount="4" Badges="False" Visibility="Collapsed" />
                    <local:EmptyState x:Name="NoParts" Visibility="Collapsed" Glyph="&#xE8B7;" Title="No externals"
                                      Text="This checkout is one working copy. The branch is one copy of it." />
                </Grid>
            </Grid>

            <Thumb x:Name="Splitter" Grid.Column="1" Style="{StaticResource Splitter}" />

            <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="6">
                <TextBlock Text="Plan" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <!-- No plan yet is the whole space under the header, not a sentence boxed in an empty card. -->
                <Grid Grid.Row="1">
                    <Border x:Name="PlanCard" Style="{StaticResource Card}" Padding="12,8" Visibility="Collapsed">
                        <TextBox x:Name="Plan" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                 BorderThickness="0" Background="Transparent" Padding="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </Border>
                    <local:EmptyState x:Name="NoPlan" Glyph="&#xE9D9;" Title="No plan yet"
                                      Text="Give the branch a name, pick the checkout to copy from, and press Dry run. The plan lists every revision the server would get." />
                </Grid>
            </Grid>
        </Grid>

        <local:StatusStrip x:Name="Pane" Grid.Row="2" />
    </Grid>
</local:SgPage>
