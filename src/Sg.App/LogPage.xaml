<local:SgPage
    x:Class="Sg.App.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- A rewrite empties the selection and reloads the list, and its result has to outlive that. -->
        <InfoBar x:Name="ResultBar" Grid.Row="0" Severity="Success" IsClosable="True" IsOpen="False" Margin="0,0,0,8" />

        <local:EmptyState x:Name="NoCommits" Grid.Row="1" Visibility="Collapsed" Glyph="&#xE81C;" Title="No history yet"
                          Text="The branch has no commits of its own and no snapshot under it.">
            <local:EmptyState.Action>
                <Button Content="Close" Click="Close_Click" ToolTipService.ToolTip="Back to where you came from." />
            </local:EmptyState.Action>
        </local:EmptyState>

        <Grid x:Name="Filled" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="540" MinWidth="320" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- The commits and the details take the height they need, up to a cap; the files get the rest.
                 A branch with seven commits used to leave half the column empty over a tree of seventy files. -->
            <Grid x:Name="Column" Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="CommitsHeader" Text="Commits on the branch, then the snapshots under it" Style="{StaticResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="CommitFilterBox" Grid.Column="1" PlaceholderText="Filter commits  (Ctrl+Shift+F)" FontSize="12" MinWidth="200"
                             ToolTipService.ToolTip="Show only the commits whose message, author, date or sha has this text. Every word typed has to be found. The snapshots are searched too." />
                </Grid>
                <!-- The commit actions are on the rows they act on: a right click, Shift+F10 or the Menu
                     key. This line says so, and says which of them the picked commits rule out. They act
                     on the branch's own commits, so none touches a snapshot: those are what SVN said. -->
                <TextBlock x:Name="PickHint" Grid.Row="1" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                           Text="Right-click a commit to squash, reword, revert, push alone, shelve or discard. Ctrl or Shift picks more than one." />
                <Border x:Name="CommitsBody" Grid.Row="2" Style="{StaticResource Card}" Padding="4" MaxHeight="320">
                    <Grid>
                        <local:RowListView x:Name="Commits" SelectionMode="Extended" SelectionChanged="Commits_SelectionChanged" ItemTemplate="{StaticResource CommitRowTemplate}" />
                        <local:Skeleton x:Name="CommitsSkeleton" RowCount="7" Badges="False" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Thumb x:Name="CommitsSplitter" Grid.Row="3" Style="{StaticResource SplitterRow}" />

                <Grid Grid.Row="4" ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                    <local:SectionChevron x:Name="DetailsChevron" />
                    <TextBlock Grid.Column="1" Text="Details" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                </Grid>
                <Border x:Name="DetailsBody" Grid.Row="5" Style="{StaticResource Card}" Padding="12,8" MaxHeight="200">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="DetailHead" Style="{StaticResource Secondary}" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="DetailMessage" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Thumb x:Name="DetailsSplitter" Grid.Row="6" Style="{StaticResource SplitterRow}" />

                <Grid Grid.Row="7" ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,0">
                    <local:SectionChevron x:Name="FilesChevron" />
                    <TextBlock x:Name="FilesHeader" Grid.Column="1" Text="Files" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <TextBox x:Name="Filter" Grid.Column="2" PlaceholderText="Filter files  (Ctrl+F)" Visibility="Collapsed" FontSize="12" MinWidth="200"
                             ToolTipService.ToolTip="Show only the rows whose status or path contains this text." />
                </Grid>
                <Border x:Name="FilesBody" Grid.Row="8" Style="{StaticResource Card}" Padding="4">
                    <Grid>
                        <local:RowTreeView x:Name="Files" ItemTemplate="{StaticResource FileTreeTemplate}" />
                        <local:Skeleton x:Name="FilesSkeleton" RowCount="5" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>

            <Thumb x:Name="Splitter" Grid.Column="1" Style="{StaticResource Splitter}" />

            <Border Grid.Column="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <local:DiffView x:Name="Diff" Margin="1" />
            </Border>
        </Grid>

        <!-- The message a squash or a reword writes, asked for the same way every commit asks for one. -->
        <local:MessageDialog x:Name="Message" Title="Squash" PrimaryButtonText="Squash" Minimum="1"
                             Header="Message for the commit that replaces them" CountTip="A git commit needs a message. Nothing here reaches SVN." />

        <local:StatusStrip x:Name="Pane" Grid.Row="2" Margin="0,8,0,0" />
    </Grid>
</local:SgPage>
