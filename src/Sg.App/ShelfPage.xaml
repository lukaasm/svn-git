<local:SgPage
    x:Class="Sg.App.ShelfPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- A restore empties the list and reloads it, and what it did has to outlive that. -->
        <InfoBar x:Name="ResultBar" Grid.Row="0" Severity="Success" IsClosable="True" IsOpen="False" Margin="0,0,0,8" />

        <local:EmptyState x:Name="Empty" Grid.Row="1" Visibility="Collapsed" Glyph="&#xE7B8;" Title="Nothing on the shelf"
                          Text="A shelf holds changes you are not ready to commit: they leave the working copy and wait here. Use Shelve on a changes page, or when a push refuses because the checkout has an edit on the same file.">
            <local:EmptyState.Action>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <local:IconButton x:Name="EmptyChanges" Glyph="&#xE70F;" Text="Open the changes" Click="Changes_Click" Style="{StaticResource AccentButtonStyle}"
                                      ToolTipService.ToolTip="The changes of this working copy, where Shelve puts some of them aside." />
                    <Button Content="Close" Click="Close_Click" ToolTipService.ToolTip="Back to where you came from." />
                </StackPanel>
            </local:EmptyState.Action>
        </local:EmptyState>

        <Grid x:Name="Filled" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="560" MinWidth="340" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="Column" Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="6">
                <TextBlock x:Name="ListHeader" Text="Shelves" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <!-- What can be done to the shelf that is picked. Putting it back is the one that is meant,
                     so it is the loud one, with keeping a copy in its menu. Drop is in a row's own menu,
                     with Delete on the list for the keyboard. -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                    <local:TaskGate>
                        <local:AccentSplitButton x:Name="RestoreButton" AutomationProperties.Name="Put back" Click="Restore_Click" IsEnabled="False"
                                                 ToolTipService.ToolTip="Write these changes back into the folder they came from, and take the shelf off. A file that changed since gets the change merged into it.">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7B8;" FontSize="14" />
                                <TextBlock Text="Put back" />
                            </StackPanel>
                            <local:AccentSplitButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft" local:MenuGate.Watch="True">
                                    <MenuFlyoutItem x:Name="KeepButton" Text="Put back and keep" Click="RestoreKeep_Click" local:MenuGate.Gated="True"
                                                    ToolTipService.ToolTip="The same, and the shelf stays where it is. For trying a change in two places.">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </local:AccentSplitButton.Flyout>
                        </local:AccentSplitButton>
                    </local:TaskGate>
                </StackPanel>

                <Border x:Name="ShelvesBody" Grid.Row="2" Style="{StaticResource Card}" Padding="4" MaxHeight="260">
                    <Grid>
                        <local:RowListView x:Name="Shelves" SelectionChanged="Shelves_SelectionChanged" ItemTemplate="{StaticResource ShelfRowTemplate}" />
                        <local:Skeleton x:Name="ShelvesSkeleton" RowCount="4" Badges="False" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Thumb x:Name="ShelvesSplitter" Grid.Row="3" Style="{StaticResource SplitterRow}" />

                <Grid Grid.Row="4" ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                    <local:SectionChevron x:Name="DetailsChevron" />
                    <TextBlock Grid.Column="1" Text="Details" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                </Grid>
                <Border x:Name="DetailsBody" Grid.Row="5" Style="{StaticResource Card}" Padding="12,8">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="DetailHead" Style="{StaticResource Secondary}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailWhere" Style="{StaticResource Secondary}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        <InfoBar x:Name="GoneBar" Severity="Warning" IsClosable="False" IsOpen="False"
                                 Message="The folder this shelf came from is not there any more, so it has nowhere to go back to." />
                    </StackPanel>
                </Border>

                <Thumb x:Name="DetailsSplitter" Grid.Row="6" Style="{StaticResource SplitterRow}" />

                <Grid Grid.Row="7" ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,0">
                    <local:SectionChevron x:Name="FilesChevron" />
                    <TextBlock x:Name="FilesHeader" Grid.Column="1" Text="Files" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <TextBox x:Name="Filter" Grid.Column="2" PlaceholderText="Filter files  (Ctrl+F)" Visibility="Collapsed" FontSize="12" MinWidth="200"
                             ToolTipService.ToolTip="Show only the rows whose status or path contains this text." />
                </Grid>
                <Border x:Name="FilesBody" Grid.Row="8" Style="{StaticResource Card}" Padding="4">
                    <Grid>
                        <local:RowTreeView x:Name="Files" ItemTemplate="{StaticResource FileTreeTemplate}" />
                        <local:Skeleton x:Name="FilesSkeleton" RowCount="5" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>

            <Thumb x:Name="Splitter" Grid.Column="1" Style="{StaticResource Splitter}" />

            <Border Grid.Column="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <local:DiffView x:Name="Diff" Margin="1" />
            </Border>
        </Grid>

        <local:StatusStrip x:Name="Pane" Grid.Row="2" Margin="0,8,0,0" />
    </Grid>
</local:SgPage>
