<local:SgPage
    x:Class="Sg.App.MergePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- A merge that landed sends the user on to the checkout changes, and its result outlives the reload. -->
        <StackPanel Spacing="8" Margin="0,0,0,8">
            <InfoBar x:Name="ResultBar" Severity="Success" IsClosable="True" IsOpen="False" />
            <InfoBar x:Name="SelectionNotice" Severity="Warning" IsClosable="False" IsOpen="False" />
        </StackPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">
            <!-- Runs from the first server call. Before it, the two round trips that fill the two combo
                 boxes happened under a page that looked finished and empty. -->
            <ProgressBar x:Name="BusyBar" Style="{StaticResource LoadingBar}" Canvas.ZIndex="1" Margin="0,-8,0,0" />
            <!-- Where it goes and where it comes from. A merge stays inside one repository, so the branches
                 on offer are the siblings of whichever working copy is picked here. -->
            <local:WrapRow Spacing="16">
                <StackPanel Width="340" Spacing="6">
                <TextBlock Text="Into" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <ComboBox x:Name="TargetBox" HorizontalAlignment="Stretch" SelectionChanged="Target_Changed" AutomationProperties.Name="Merge into"
                          DisplayMemberPath="Label" ToolTipService.ToolTip="The working copy the changes land in: the checkout root, or one of its externals." />
                </StackPanel>
                <StackPanel Width="340" Spacing="6">
                <TextBlock Text="From" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <ComboBox x:Name="SourceBox" HorizontalAlignment="Stretch" SelectionChanged="Source_Changed" AutomationProperties.Name="Merge from"
                          DisplayMemberPath="Name" ToolTipService.ToolTip="The branch of the same repository the changes come from." />
                </StackPanel>
            </local:WrapRow>

            <InfoBar x:Name="ProblemBar" Grid.Row="1" Severity="Warning" IsClosable="False" IsOpen="False" Margin="0,0,0,8" />

            <SelectorBar x:Name="CompactViews" Grid.Row="2" Visibility="Collapsed" AutomationProperties.Name="Review view">
                <SelectorBarItem x:Name="RevisionsTab" Text="Revisions">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE81C;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="PreviewTab" Text="Preview">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE8A5;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
            <Grid x:Name="Body" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftCol" Width="560" MinWidth="320" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="RevisionsPane" Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock x:Name="RevisionsHeader" Text="Revisions on that branch" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <!-- Only while something is picked, or while a saved pick is missing: then it is the way on. -->
                        <Button x:Name="ClearPickButton" Grid.Column="1" Content="Clear selection" Click="ClearPick_Click" FontSize="12" Padding="8,2" MinHeight="0" Visibility="Collapsed"
                                ToolTipService.ToolTip="Go back to merging everything this branch has not got yet, instead of named revisions." />
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="PickHint" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                               Text="Pick nothing and the merge takes everything this branch has not got. Pick revisions, with Ctrl or Shift, and it takes only those." />
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
                        <Grid>
                            <local:RowListView x:Name="Revisions" SelectionMode="Extended" SelectionChanged="Revisions_SelectionChanged"
                                               ItemTemplate="{StaticResource RevisionRowTemplate}" />
                            <local:Skeleton x:Name="RevisionsSkeleton" RowCount="8" Badges="False" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>

                <Thumb x:Name="Splitter" Grid.Column="1" Style="{StaticResource Splitter}" />

                <Grid x:Name="PreviewPane" Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="6">
                    <TextBlock x:Name="OutcomeHeader" Text="What a merge would do" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <local:DiffView x:Name="Diff" Margin="1" />
                    </Border>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="4" Spacing="8">
                <TextBlock x:Name="Summary" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                <!-- Merge, and the same merge run backwards in its dropdown; the preview beside them; what is
                     only looked at, and the reread F5 also does, in More. -->
                <local:WrapRow Spacing="8">
                <local:TaskGate>
                    <local:AccentSplitButton x:Name="MergeButton" Click="Merge_Click" AutomationProperties.Name="Merge" IsEnabled="False"
                            ToolTipService.ToolTip="Bring the changes into the checkout. They land as local changes there; nothing is committed until you commit them.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                            <TextBlock x:Name="MergeLabel" Text="Merge" />
                        </StackPanel>
                        <local:AccentSplitButton.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedLeft" local:MenuGate.Watch="True">
                                <MenuFlyoutItem x:Name="TakeOutButton" Text="Take back out…" Click="TakeOut_Click" IsEnabled="False" local:MenuGate.Gated="True"
                                                ToolTipService.ToolTip="Reverse the selected revisions as local checkout changes. Asks before applying.">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </local:AccentSplitButton.Flyout>
                    </local:AccentSplitButton>
                </local:TaskGate>
                <local:ActionHint><local:IconButton x:Name="TestButton" Glyph="&#xE9D9;" Text="Preview merge" Click="Test_Click" IsEnabled="False"
                                  ToolTipService.ToolTip="Run the merge without writing anything, and list what it would change." /></local:ActionHint>
                <local:IconButton x:Name="MoreButton" Glyph="&#xE712;" Text="More" AutomationProperties.Name="More actions">
                    <Button.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedLeft">
                            <MenuFlyoutItem x:Name="CheckoutChangesButton" Text="Checkout changes" Click="CheckoutChanges_Click"
                                            ToolTipService.ToolTip="Review local checkout edits. Your merge selection is kept when you return.">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="RefreshButton" Text="Refresh" Click="Refresh_Click"
                                            ToolTipService.ToolTip="Read the branches and their revisions again. F5 does the same.">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </local:IconButton>
                </local:WrapRow>
            </StackPanel>
        </Grid>

        <local:StatusStrip x:Name="Pane" Grid.Row="2" Margin="0,8,0,0" />
    </Grid>
</local:SgPage>
