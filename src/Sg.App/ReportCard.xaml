<UserControl
    x:Class="Sg.App.ReportCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App">
    <!-- How an operation went, on the page that ran it: one badge and one sentence, a chip per outcome with its
         count and the words in its tooltip, then a row for everything that did not simply go - so a failure is
         a red row with its reason on the page, not a line at the foot of the window.
         No element here may share a name with a property the rows bind to: an x:Name "Detail" beside an
         x:Bind to Detail stopped the XAML compiler with an internal error and no message. -->
    <StackPanel Spacing="4">
        <Border Style="{StaticResource Card}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                <Grid VerticalAlignment="Top" Margin="0,2,0,0">
                    <local:StatusChip x:Name="Chip" />
                    <ProgressRing x:Name="Ring" Width="18" Height="18" MinWidth="18" MinHeight="18" IsActive="False" Visibility="Collapsed" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock x:Name="Headline" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailText" Style="{StaticResource Secondary}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
                <ItemsControl x:Name="Counts" Grid.Column="2" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ReportCount">
                            <local:StatusChip Severity="{x:Bind Severity}" Glyph="{x:Bind Glyph}" Count="{x:Bind Count}" ToolTipService.ToolTip="{x:Bind Tip}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Only where the report is about one moment rather than a standing state: the overview's own operations. -->
                <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource QuietButton}" Padding="4" MinWidth="0" MinHeight="0"
                        VerticalAlignment="Top" Margin="0,-2,-6,0" Visibility="Collapsed" Click="Close_Click"
                        AutomationProperties.Name="Close the report" ToolTipService.ToolTip="Close this report. The log keeps every line of it.">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </Border>
        <Border x:Name="RowsCard" Style="{StaticResource Card}" Padding="4" Visibility="Collapsed">
            <local:RowListView x:Name="RowList" SelectionMode="None">
                <local:RowListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ReportRow">
                        <Grid ColumnDefinitions="Auto,220,190,*" ColumnSpacing="{StaticResource RowSpacing}" ToolTipService.ToolTip="{x:Bind Tip}">
                            <local:StatusChip Severity="{x:Bind Severity}" Glyph="{x:Bind Glyph}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource RowText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind What}" Style="{StaticResource RowTextDim}" TextTrimming="CharacterEllipsis" />
                            <!-- The reason is the point of a failed row, so it wraps rather than ending in an ellipsis. -->
                            <TextBlock Grid.Column="3" Text="{x:Bind Detail}" Style="{StaticResource RowTextDim}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </local:RowListView.ItemTemplate>
            </local:RowListView>
        </Border>
    </StackPanel>
</UserControl>
