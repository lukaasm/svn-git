<local:SgPage
    x:Class="Sg.App.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App">
    <!-- The overview groups local and remote work by worktree. A focused page loads only the selected
         backup and offers the same destination and replay options as importing a file. -->
    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="8">

        <InfoBar x:Name="ResultBar" Grid.Row="0" Severity="Success" IsClosable="True" IsOpen="False" Margin="0,0,0,8" />

        <!-- Constrain the viewport, not its content, so expanding a card cannot recenter the column. -->
        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" MaxWidth="1000" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="8" Padding="0,0,0,8">
                <local:ReportCard x:Name="ReadingBackup" AutomationProperties.AutomationId="BackupReading" />
                <InfoBar x:Name="ReadError" AutomationProperties.AutomationId="BackupReadError" Severity="Error"
                         Title="Could not read the backup repository" Message="Your last backup report is still available. Retry, or open the log for details."
                         IsOpen="False" IsClosable="False">
                    <local:WrapRow Spacing="8">
                        <local:IconButton Text="Retry" Glyph="&#xE72C;" AutomationProperties.AutomationId="BackupRetryRead" Click="RetryRead_Click" />
                        <local:IconButton Text="View error log" Glyph="&#xE8A5;" Click="ReadLog_Click" />
                    </local:WrapRow>
                </InfoBar>

                <local:EmptyState x:Name="NoBackup" Visibility="Collapsed" Glyph="&#xE74E;" Title="No backup repository is set"
                                  Text="Backups go to a git repository somewhere else: a bare folder on a share, or a hosted repository. Set its URL in Settings.">
                    <local:EmptyState.Action>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <local:IconButton Glyph="&#xE713;" Text="Settings" Click="Settings_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="Close" Click="Close_Click" />
                        </StackPanel>
                    </local:EmptyState.Action>
                </local:EmptyState>

                <local:EmptyState x:Name="Nothing" Visibility="Collapsed" Glyph="&#xE74E;" Title="Nothing of sg's is there yet"
                                  Text="Create a local worktree or connect a repository containing backups. Back up all worktrees sends every included branch.">
                    <local:EmptyState.Action>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <local:TaskGate>
                                <local:IconButton Glyph="&#xE74E;" Text="Back up all worktrees" Click="BackupAll_Click" Style="{StaticResource AccentButtonStyle}" />
                            </local:TaskGate>
                            <Button Content="Close" Click="Close_Click" />
                        </StackPanel>
                    </local:EmptyState.Action>
                </local:EmptyState>

                <StackPanel x:Name="Filled" Spacing="8">
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <FontIcon Glyph="&#xE74E;" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="Headline" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="UrlText" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="BackupToolbar" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="BackupSearch" PlaceholderText="Search by worktree or checkout"
                                 AutomationProperties.Name="Search backup worktrees" TextChanged="Search_Changed" />
                        <ComboBox x:Name="BackupFilter" Grid.Column="1" SelectedIndex="0" MinWidth="160"
                                  AutomationProperties.Name="Filter backup worktrees" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All worktrees" />
                            <ComboBoxItem Content="Needs attention" />
                            <ComboBoxItem Content="Local only" />
                            <ComboBoxItem Content="Remote only" />
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="BackupMatches" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="BranchesHeader" Text="Worktrees" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                    <TextBlock x:Name="SelectionHint" Text="Status compares commits. Working files and shelves are checked when you back up. Manage opens restore options."
                               Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    <StackPanel x:Name="Branches" Spacing="4" />
                    <local:IconButton x:Name="MoreWorktrees" Text="Show 20 more" Glyph="&#xE70E;" Visibility="Collapsed"
                                      HorizontalAlignment="Left" Click="MoreWorktrees_Click" />

                    <Expander x:Name="OthersCard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7B8;" FontSize="16" />
                                <TextBlock Text="Other saved edits and shelves" />
                            </StackPanel>
                        </Expander.Header>
                        <local:RowListView x:Name="Others" MaxHeight="240" SelectionMode="Single" SelectionChanged="Branch_Changed">
                            <local:RowListView.ItemTemplate>
                                <DataTemplate x:DataType="local:BackupRow">
                                    <Grid ColumnDefinitions="220,*,Auto" ColumnSpacing="{StaticResource RowSpacing}" ToolTipService.ToolTip="{x:Bind Tip, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowText}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind What, Mode=OneWay}" Style="{StaticResource RowTextDim}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Note, Mode=OneWay}" Style="{StaticResource RowTextDim}" Foreground="{x:Bind NoteBrush, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </local:RowListView.ItemTemplate>
                        </local:RowListView>
                    </Expander>

                    <TextBlock x:Name="PreviewTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" />
                    <local:ReportCard x:Name="PreviewLoading" AutomationProperties.AutomationId="BackupPreviewLoading" />
                    <InfoBar x:Name="PreviewError" AutomationProperties.AutomationId="BackupPreviewError" Severity="Error"
                             Title="Could not preview this backup" IsOpen="False" IsClosable="False">
                        <local:WrapRow Spacing="8">
                            <local:IconButton Text="Retry preview" Glyph="&#xE72C;" AutomationProperties.AutomationId="BackupRetryPreview" Click="RetryPreview_Click" />
                            <local:IconButton Text="Refresh list" Glyph="&#xE895;" AutomationProperties.AutomationId="BackupRefreshList" Click="RetryRead_Click" />
                        </local:WrapRow>
                    </InfoBar>
                    <InfoBar x:Name="DriftBar" Severity="Warning" IsClosable="False" IsOpen="False"
                             Title="This checkout has moved on since the backup" />

                    <local:CheckoutAppearancePreview x:Name="AppearancePreview" />

                    <TextBlock x:Name="BasesHeader" Text="The revisions it was cut from" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" Visibility="Collapsed" />
                    <Border x:Name="BasesCard" Style="{StaticResource Card}" Padding="4" Visibility="Collapsed">
                        <local:RowListView x:Name="Bases" SelectionMode="None">
                            <local:RowListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ImportBaseRow">
                                    <Grid ColumnDefinitions="180,90,90,*" ColumnSpacing="{StaticResource RowSpacing}"
                                          ToolTipService.ToolTip="{x:Bind Url}">
                                        <TextBlock Text="{x:Bind Where}" Style="{StaticResource RowText}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Exported}" Style="{StaticResource RowMonoDim}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Local}" Style="{StaticResource RowMono}" Foreground="{x:Bind LocalBrush}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Shown}" Style="{StaticResource RowTextDim}" />
                                    </Grid>
                                </DataTemplate>
                            </local:RowListView.ItemTemplate>
                        </local:RowListView>
                    </Border>

                    <TextBlock x:Name="CommitsHeader" Text="Commits" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" Visibility="Collapsed" />
                    <Border x:Name="CommitsCard" Style="{StaticResource Card}" Padding="4" Visibility="Collapsed">
                        <local:RowListView x:Name="Subjects" MaxHeight="240" SelectionMode="None">
                            <local:RowListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Style="{StaticResource RowText}" />
                                </DataTemplate>
                            </local:RowListView.ItemTemplate>
                        </local:RowListView>
                    </Border>

                    <TextBlock x:Name="ConflictsHeader" Text="Files that need a hand" Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,6,0,0" Visibility="Collapsed" />
                    <Border x:Name="ConflictsCard" Style="{StaticResource Card}" Padding="4" Visibility="Collapsed">
                        <local:RowListView x:Name="Conflicts" SelectionMode="None">
                            <local:RowListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Style="{StaticResource RowMono}" />
                                </DataTemplate>
                            </local:RowListView.ItemTemplate>
                        </local:RowListView>
                    </Border>
                </StackPanel>

                <Expander x:Name="HistoryDetails" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE81C;" FontSize="16" />
                            <TextBlock Text="Last backup result" />
                        </StackPanel>
                    </Expander.Header>
                    <local:ReportCard x:Name="LastReport" />
                </Expander>
                <local:BackupStatusView x:Name="ScheduleOverview" />
            </StackPanel>
        </ScrollViewer>

        <!-- The restore form, under the same 1000 wide column as the list it acts on: the name and the checkout on
             one line, what comes with the branch on the line under. The name box had a star column with a cap and
             left alignment, so it shrank to its text and grew as tall as the two check boxes beside it. -->
        <Grid x:Name="RestoreRow" Grid.Row="2" MaxWidth="1000" ColumnDefinitions="Auto,240,Auto,260,*" RowDefinitions="Auto,Auto"
              ColumnSpacing="10" RowSpacing="6" Margin="0,4,0,0">
            <TextBlock Text="Into checkout" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <ComboBox x:Name="IntoBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectionChanged="Into_Changed"
                      ToolTipService.ToolTip="The checkout the branch is built on. It should be one of the same SVN repository the backup names." />
            <TextBlock Grid.Column="2" Text="As branch" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Margin="10,0,0,0" />
            <TextBox x:Name="NameBox" Grid.Column="3" VerticalAlignment="Center" TextChanged="Name_TextChanged"
                     ToolTipService.ToolTip="The name the branch gets here. It starts as the name it has in the backup, which is free to be something else." />
            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="24">
                <CheckBox x:Name="WipBox" Content="With its uncommitted changes" IsChecked="True" Checked="Force_Changed" Unchecked="Force_Changed"
                          ToolTipService.ToolTip="The changes that were not committed when the backup was made come back too, through the shelf: written into the worktree when they merge, left on the shelf when one does not." />
                <CheckBox x:Name="ForceBox" Content="Replace if it exists here" Checked="Force_Changed" Unchecked="Force_Changed"
                          ToolTipService.ToolTip="Preserve the existing branch and worktree under a recovery name, then restore the backup under this name. Off, restore refuses a name that is taken." />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" MaxWidth="1000" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
            <local:TaskGate>
                <local:IconButton Glyph="&#xE74E;" Text="Back up worktree" Click="BackupNow_Click" x:Name="BackupNowButton"
                                  ToolTipService.ToolTip="Back up this worktree, its saved shelves, and its uncommitted changes when enabled in Settings." />
            </local:TaskGate>
            <local:TaskGate Grid.Column="1">
                <local:IconButton Glyph="&#xE74D;" Text="Prune worktree" Click="Prune_Click" x:Name="PruneButton"
                                  ToolTipService.ToolTip="Preview stale backup refs belonging to this worktree. Confirm the exact list before deleting." />
            </local:TaskGate>
            <local:TaskGate Grid.Column="1">
                <local:IconButton x:Name="AllWorktreesButton" Text="All worktrees…" Glyph="&#xE712;" AutomationProperties.Name="All worktrees actions">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Back up all worktrees" AutomationProperties.AutomationId="BackupAll" Click="BackupAll_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Prune all stale backups" AutomationProperties.AutomationId="PruneAll" Click="PruneAll_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </local:IconButton>
            </local:TaskGate>
            <Button Grid.Column="2" Content="Close" Click="Close_Click" ToolTipService.ToolTip="Back to where you came from. Nothing is written by leaving." />
            <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center" Margin="8,0">
                <TextBlock x:Name="Summary" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                <local:DestinationAction x:Name="ExistingDestination" />
            </StackPanel>
            <local:TaskGate Grid.Column="4">
                <Button x:Name="RestoreButton" Style="{StaticResource AccentButtonStyle}" Click="Restore_Click"
                        AutomationProperties.Name="{Binding Text, ElementName=RestoreLabel}"
                        ToolTipService.ToolTip="Make the branch and its worktree here, then merge every commit onto this checkout's snapshot.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="14" />
                        <TextBlock x:Name="RestoreLabel" Text="Restore" />
                    </StackPanel>
                </Button>
            </local:TaskGate>
        </Grid>

        <local:StatusStrip x:Name="Pane" Grid.Row="4" Margin="0,8,0,0" />
    </Grid>
</local:SgPage>
