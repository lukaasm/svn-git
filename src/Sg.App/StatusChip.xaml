<UserControl
    x:Class="Sg.App.StatusChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    VerticalAlignment="Center">
    <!-- The platform's InfoBadge, with a glyph and a count in the same pill: 16 tall, a full round end,
         4 in from each side, the value in the 11 the badge on a NavigationViewItem uses. A solid fill in
         the severity's colour and the on-accent foreground on it, so the chip on a card and the badge on
         the pane are one thing. Words never go inside a badge; they sit beside it in the caption size. -->
    <StackPanel Orientation="Horizontal" Spacing="6">
        <Border x:Name="Pill" Height="16" MinWidth="16" CornerRadius="8" Padding="4,0,4,1" Background="{x:Null}">
            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                <FontIcon x:Name="Icon" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="CountText" FontSize="{ThemeResource InfoBadgeValueFontSize}" VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="Label" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
