<local:SgPage
    x:Class="Sg.App.CommitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Above both states: a commit that just went through empties the page, and its result must outlive that. -->
        <InfoBar x:Name="ResultBar" Grid.Row="0" Severity="Success" IsClosable="True" IsOpen="False" Margin="0,0,0,8" />

        <!-- A clean worktree has no list to pick from, no diff to read and no message to write, so none of
             that is on screen: the page is the one sentence, and the two buttons that still mean something. -->
        <local:EmptyState x:Name="NoChanges" Grid.Row="1" Visibility="Collapsed" Glyph="&#xE73E;" Title="Nothing to commit"
                          Text="Every file in the worktree matches the last commit. Edit something here, or let an agent, and it shows up on this page.">
            <local:EmptyState.Action>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <local:IconButton Glyph="&#xE72C;" Text="Refresh" Click="Refresh_Click" ToolTipService.ToolTip="Read the changes in the worktree again. F5 does the same." />
                    <local:IconButton x:Name="CleanShelfButton" Glyph="&#xE7B8;" Text="Shelved changes" Click="Shelf_Click" Visibility="Collapsed"
                                      ToolTipService.ToolTip="Changes put aside from this branch. The worktree is clean because they are waiting here." />
                    <!-- The only way in to a message-only amend: with nothing changed, the page below is not on screen. -->
                    <local:IconButton x:Name="AmendFromEmpty" Glyph="&#xE70F;" Text="Reword the last commit" Click="AmendFromEmpty_Click"
                                      ToolTipService.ToolTip="Replace the last commit with one that has the same files and a new message. Only for a commit that has not been pushed." />
                    <Button Content="Close" Click="Close_Click" ToolTipService.ToolTip="Back to where you came from." />
                </StackPanel>
            </local:EmptyState.Action>
        </local:EmptyState>

        <Grid x:Name="Filled" Grid.Row="1" RowDefinitions="*,Auto">
            <Grid x:Name="Body" Grid.Row="0" Padding="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftCol" Width="560" MinWidth="320" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="6">
                    <!-- The filter takes what the header leaves; the actions get a row of their own, so
                         none of them is cut off when the split is dragged narrow. -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock x:Name="FilesHeader" Text="Changes" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBox x:Name="Filter" Grid.Column="1" PlaceholderText="Filter files  (Ctrl+F)" Visibility="Collapsed" FontSize="12" VerticalAlignment="Center"
                                 ToolTipService.ToolTip="Show only the rows whose status or path contains this text. It changes the list, never what is checked or discarded." />
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                        <Button Content="All" Click="All_Click" ToolTipService.ToolTip="Check every change, untracked files too." />
                        <Button Content="None" Click="None_Click" ToolTipService.ToolTip="Uncheck everything." />
                        <local:IconButton Glyph="&#xE710;" Text="Stage"
                            Click="Stage_Click" ToolTipService.ToolTip="Put the whole of every checked file in the index. A commit then takes exactly that, whatever you edit afterwards." />
                        <local:IconButton Glyph="&#xE738;" Text="Unstage"
                            Click="Unstage_Click" ToolTipService.ToolTip="Take the checked files out of the index again. The files on disk are untouched." />
                        <local:IconButton Glyph="&#xE7A7;" Text="Discard"
                            Click="Discard_Click" ToolTipService.ToolTip="Put the checked files back the way the last commit has them; untracked files get deleted. Asks first, and Undo on the bar brings them back for a week." />
                        <local:IconButton Glyph="&#xE7B8;" Text="Shelve"
                            Click="Shelve_Click" ToolTipService.ToolTip="Take the checked changes out of the worktree and keep them, to put back later. The branch is left clean, so a rebase or a push can run." />
                    </StackPanel>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
                        <Grid>
                            <local:RowTreeView x:Name="Files" ItemTemplate="{StaticResource CheckedFileTreeTemplate}" />
                            <local:Skeleton x:Name="FilesSkeleton" RowCount="8" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>

                <Thumb x:Name="Splitter" Grid.Column="1" Style="{StaticResource Splitter}" />

                <Border Grid.Column="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <local:DiffView x:Name="Diff" Margin="1" />
                </Border>
            </Grid>

            <!-- The message is asked for on the press, in a dialog, not held open under the list: the list and the diff are
                 what the page is for, and the box would sit empty through all of the reading. -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                <local:IconButton Glyph="&#xE72C;" Text="Refresh"
                    Click="Refresh_Click" ToolTipService.ToolTip="Read the changes in the worktree again. F5 does the same." />
                <Button Grid.Column="1" Content="Close" Click="Close_Click" ToolTipService.ToolTip="Back to where you came from. Unchecked and uncommitted changes stay as they are." />
                <local:IconButton Grid.Column="2" x:Name="ShelfButton" Glyph="&#xE7B8;" Text="Shelved changes" Click="Shelf_Click"
                    ToolTipService.ToolTip="What is already put aside from this branch, and the button that writes it back." />
                <CheckBox Grid.Column="3" x:Name="Amend" Content="Amend" Click="Amend_Click" VerticalAlignment="Center" MinWidth="0"
                          ToolTipService.ToolTip="Replace the last commit instead of adding one under it. Its files stay in it, and the checked ones join them. Only for a commit that has not been pushed." />
                <TextBlock Grid.Column="4" x:Name="Summary" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <!-- The left half commits. The right half is the other thing to do with the same checked
                     files: put them aside instead. Both act on exactly what is ticked, so the decision at
                     the end of reading a diff - send it, or keep it for later - is one button. -->
                <local:AccentSplitButton Grid.Column="5" AutomationProperties.Name="Commit" x:Name="CommitButton"
                                         Click="Commit_Click"
                                         ToolTipService.ToolTip="Write the message, then commit the checked files to the git branch under your own git identity. Nothing goes to SVN. Ctrl+Enter opens this too.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" />
                        <TextBlock x:Name="CommitLabel" Text="Commit" />
                    </StackPanel>
                    <local:AccentSplitButton.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedRight">
                            <MenuFlyoutItem Text="Shelve them instead" Click="Shelve_Click"
                                            ToolTipService.ToolTip="Take the checked changes out of the worktree and keep them, to put back later. The branch is left clean, so a rebase or a push can run.">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7B8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Shelved changes" Click="Shelf_Click"
                                            ToolTipService.ToolTip="What is already put aside from this branch, and the button that writes it back.">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE81C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </local:AccentSplitButton.Flyout>
                </local:AccentSplitButton>
            </Grid>
        </Grid>

        <!-- The message, asked for in a dialog over the middle of the window. Cancel keeps the text for the next time. -->
        <local:MessageDialog x:Name="Message" Title="Commit" PrimaryButtonText="Commit" Minimum="1"
                             Header="Commit message" CountTip="A git commit needs a message. Nothing here reaches SVN." />

        <local:StatusStrip x:Name="Pane" Grid.Row="2" Margin="0,8,0,0" />
    </Grid>
</local:SgPage>
