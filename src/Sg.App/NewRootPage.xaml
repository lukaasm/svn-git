<local:SgPage
    x:Class="Sg.App.NewRootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App">
    <Grid RowDefinitions="*,Auto,Auto" RowSpacing="8">
        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="12" MaxWidth="1000" Padding="0,0,0,16">

                <!-- Step 1: the store -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="1" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Make the root" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <FontIcon x:Name="Step1Tick" Glyph="&#xE73E;" FontSize="14" Visibility="Collapsed" VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap"
                                   Text="Creates a .sg folder here. It holds the shared git store, the list of checkouts, and the branch worktrees. SVN never sees it." />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="RootBox" Header="Root folder" PlaceholderText="D:\work" />
                            <Button Grid.Column="1" Content="Browse" Click="BrowseRoot_Click" VerticalAlignment="Bottom"
                                    ToolTipService.ToolTip="Pick the folder that will hold .sg. Usually the folder that already holds your SVN checkout." />
                        </Grid>
                        <CheckBox x:Name="FsMonitor" Content="Use git fsmonitor" IsChecked="True"
                                  ToolTipService.ToolTip="A background service that makes git status fast on a big worktree. Turn it off if your machine forbids it." />
                        <local:IconButton Glyph="&#xE8F4;" Text="Create the root"
                            x:Name="CreateRootButton" Style="{StaticResource AccentButtonStyle}" Click="CreateRoot_Click" ToolTipService.ToolTip="Same as 'sg init &lt;folder&gt;'. Fast, and it touches nothing outside .sg." />
                    </StackPanel>
                </Border>

                <!-- Step 2: the first checkout -->
                <Border x:Name="Step2" Style="{StaticResource Card}" Opacity="0.5">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="2" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Register the first SVN checkout" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="optional" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                            <FontIcon x:Name="Step2Tick" Glyph="&#xE73E;" FontSize="14" Visibility="Collapsed" VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap"
                                   Text="A working copy already on disk, or one svn checks out from a URL first. Then every versioned file is hashed once into the store and one file is written into the checkout: .git, a one-line pointer back to the root. A 16 GB checkout takes minutes. You can go back and do it later instead." />
                        <local:CheckoutFields x:Name="Fields" />
                        <local:IconButton Glyph="&#xE896;" Text="Add the checkout"
                            x:Name="AddButton" Style="{StaticResource AccentButtonStyle}" Click="AddCheckout_Click" ToolTipService.ToolTip="Same as 'sg checkout add'. This is the long step: it reads and hashes every versioned file once." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="FinishButton" Content="Finish" Click="Close_Click"
                    ToolTipService.ToolTip="Back to the overview, which opens the new root." />
        </StackPanel>

        <local:StatusStrip x:Name="Pane" Grid.Row="2" />
    </Grid>
</local:SgPage>
