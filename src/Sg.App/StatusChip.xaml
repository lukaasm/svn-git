<UserControl
    x:Class="Sg.App.StatusChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Spacing="6">
        <Border x:Name="Pill" Height="22" MinWidth="22" CornerRadius="6" Padding="6,0" BorderThickness="1" Background="{x:Null}">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <FontIcon x:Name="Icon" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="CountText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="Label" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
