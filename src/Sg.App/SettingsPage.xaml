<local:SgPage
    x:Class="Sg.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <!-- Windows Settings shape: a heading per group, one card per setting, the control on the right.
         Every control writes its setting the moment it changes; there is nothing to save. -->
    <Grid RowDefinitions="*,Auto" RowSpacing="8">
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="4" MaxWidth="1000" Padding="0,0,0,16">

                <TextBlock Text="Explorer" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,4" />
                <controls:SettingsExpander Header="The sg menu on folders" IsExpanded="True"
                                           Description="Classic menu: right click a folder, then 'Show more options' on Windows 11. The menu points at this exe, so install it from its final folder.">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Install" Click="InstallMenu_Click" ToolTipService.ToolTip="Add the sg menu to the Explorer context menu for this user. Registry only, no admin rights." />
                        <Button Content="Remove" Click="RemoveMenu_Click" ToolTipService.ToolTip="Take the sg menu out of the Explorer context menu." />
                    </StackPanel>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Name="MenuState" Header="Where the menu points" />
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <TextBlock Text="Bridge" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />
                <TextBlock x:Name="RootText" Style="{StaticResource Secondary}" Margin="0,0,0,4" />
                <controls:SettingsCard Header="Minimum SVN commit message length"
                                       Description="The server refuses a shorter message. Push and Commit to SVN stop before it does.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </controls:SettingsCard.HeaderIcon>
                    <NumberBox x:Name="MinLength" Minimum="0" Maximum="500" SpinButtonPlacementMode="Compact" Width="140" ValueChanged="Number_Changed" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="Agents may push"
                                       Description="Allow 'sg push' without an interactive terminal. Off means only a human pushes, from a terminal or from here.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE898;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="AgentPush" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                </controls:SettingsCard>

                <TextBlock Text="Backup" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                <controls:SettingsCard Header="Backup repository URL"
                                       Description="A git repository somewhere else: a bare folder on a share, or a hosted repository. Every branch, the uncommitted changes and the shelves go there as thin histories that hold only the files you changed, never the SVN tree. Empty turns backups off.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE74E;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="BackupUrl" PlaceholderText="\\nas\git\fort-backup.git" Width="360" />
                        <Button x:Name="BackupCheck" Content="Check" Click="BackupCheck_Click" ToolTipService.ToolTip="Ask the URL whether a git repository answers there." />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard Header="Folder on the remote"
                                       Description="Every ref goes under this name, so two machines can back up into one repository without writing over each other. Empty is none.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </controls:SettingsCard.HeaderIcon>
                    <TextBox x:Name="BackupPrefix" PlaceholderText="this-machine" Width="220" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="Uncommitted changes go too"
                                       Description="What is changed and not committed in a worktree, and the local edits of a checkout, go with each backup as one commit above the branch. Off sends committed work only.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE70F;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="BackupUncommitted" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="Back up every N minutes"
                                       Description="The app sends what changed on this schedule, and a few seconds after a commit, a shelve or a rebase made here. 0 turns the timer off; Backup on the checkout still sends on demand.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE823;" />
                    </controls:SettingsCard.HeaderIcon>
                    <NumberBox x:Name="BackupMinutes" Minimum="0" Maximum="1440" SpinButtonPlacementMode="Compact" Width="140" ValueChanged="Number_Changed" />
                </controls:SettingsCard>

                <TextBlock Text="Background" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                <controls:SettingsCard Header="Keep running in the tray"
                                       Description="Closing the overview hides it into the notification area. The project monitor keeps checking. Right click the tray icon for the menu, Exit ends the app.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE823;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="Tray" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="Start with Windows"
                                       Description="Starts sg hidden in the tray when you log in. A Run entry for this user, pointing at this exe.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="Startup" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                </controls:SettingsCard>
                <controls:SettingsExpander Header="Notifications"
                                           Description="A Windows toast when the server has new commits, and when a sync or push finishes while you work in another app.">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE7E7;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <ToggleSwitch x:Name="Notify" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Name="NotifyState" Header="Registration with Windows">
                            <Button x:Name="TestNotify" Content="Send a test" Click="TestNotify_Click"
                                    ToolTipService.ToolTip="Sends one toast now, shaped like the monitor's. Pressing that toast opens the project monitor, which is what a real one does." />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <controls:SettingsCard Header="Server check every N minutes"
                                       Description="The overview asks the SVN server for new commits on this schedule and shows a badge. 0 turns it off.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE895;" />
                    </controls:SettingsCard.HeaderIcon>
                    <NumberBox x:Name="RemoteMinutes" Minimum="0" Maximum="120" SpinButtonPlacementMode="Compact" Width="140" ValueChanged="Number_Changed" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="Update check every N minutes"
                                       Description="The overview asks GitHub for a newer sg build on this schedule and offers 'Update and restart'. 0 turns it off.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE896;" />
                    </controls:SettingsCard.HeaderIcon>
                    <NumberBox x:Name="UpdateMinutes" Minimum="0" Maximum="1440" SpinButtonPlacementMode="Compact" Width="140" ValueChanged="Number_Changed" />
                </controls:SettingsCard>

                <TextBlock Text="This app" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                <!-- Which build this is, said here because nowhere else in the app said it: the pane's
                     Update and restart appears only once a newer one is found, and a crash report was
                     the only other place the number went. -->
                <controls:SettingsCard x:Name="BuildCard" Header="Installed build">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton Content="Release notes" NavigateUri="https://github.com/lukaasm/svn-git/releases/tag/latest-build"
                                         ToolTipService.ToolTip="The rolling latest-build release on GitHub, which every sg update installs from." />
                        <local:IconButton x:Name="CheckBuild" Glyph="&#xE895;" Text="Check now" Click="CheckBuild_Click"
                                          ToolTipService.ToolTip="Ask GitHub for the newest build now, instead of waiting for the timer above." />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard Header="Editor command"
                                       Description="Program that 'Open in editor' runs on a worktree folder, for example code or cursor. Empty uses the Windows default for a folder.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE70F;" />
                    </controls:SettingsCard.HeaderIcon>
                    <!-- Written as it is typed, on a pause. On LostFocus alone, leaving the page with the
                         caret still in the box - Escape, the back arrow, the Close button - saved nothing. -->
                    <TextBox x:Name="EditorCommand" PlaceholderText="code" Width="220" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="Diff colours"
                                       Description="The palette the diff reads in, and the colours of the status letters beside a file name. Changing it repaints every diff already open.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="ThemeBox" Width="220" SelectionChanged="Theme_Changed"
                              ToolTipService.ToolTip="sg's own, and the palettes you already have in your editor. A light one on a dark Windows leaves the rest of the app alone." />
                </controls:SettingsCard>
                <controls:SettingsCard Header="Monaco editor URL"
                                       Description="The 'vs' folder of a Monaco build. The diff viewer loads it from here when no copy ships next to the exe. Plain unified diff text is the fallback.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE943;" />
                    </controls:SettingsCard.HeaderIcon>
                    <TextBox x:Name="MonacoUrl" Width="360" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="Verbose log" Description="Show every git and svn command in the log.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="Verbose" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                </controls:SettingsCard>

                <TextBlock Text="Keyboard" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                <controls:SettingsExpander Header="Shortcuts" Description="The keys that work on every page.">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE765;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="Ctrl+F" Description="Jump to the filter box over a file list" />
                        <controls:SettingsCard Header="Ctrl+Shift+F" Description="Jump to the filter box over a commit list, on Log and Push" />
                        <controls:SettingsCard Header="Ctrl+K" Description="Go to any checkout, worktree or page by typing part of its name, in the main window" />
                        <controls:SettingsCard Header="Ctrl+Enter" Description="Commit, or push, when the button is enabled" />
                        <controls:SettingsCard Header="F7" Description="Next change in the diff. Shift+F7 for the previous one" />
                        <controls:SettingsCard Header="F5" Description="Read every checkout and worktree again, in the overview" />
                        <controls:SettingsCard Header="Alt+Left, Alt+Right" Description="Back and forward, like the two buttons over the page. The thumb buttons on a mouse do the same" />
                        <controls:SettingsCard Header="Esc" Description="Back, or close the window, unless you are typing in a box" />
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Close" Click="Close_Click" ToolTipService.ToolTip="Back to where you came from. Every change here is already written." />
            <TextBlock x:Name="Status" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</local:SgPage>
