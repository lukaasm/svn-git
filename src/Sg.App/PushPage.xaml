<local:SgPage
    x:Class="Sg.App.PushPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Above both states: a push that just went through empties the page, and its result must outlive that. -->
        <InfoBar x:Name="ResultBar" Grid.Row="0" Severity="Success" IsClosable="True" IsOpen="False" Margin="0,0,0,8" />

        <!-- A branch that equals its snapshot has no commits to list, no files, no message worth writing:
             the page is the one sentence, and the two buttons that still mean something. -->
        <local:EmptyState x:Name="NothingToPush" Grid.Row="1" Visibility="Collapsed" Glyph="&#xE73E;" Title="Nothing to push"
                          Text="The branch equals its snapshot: everything on it is already in SVN. Commit something on the branch and it shows up here.">
            <local:EmptyState.Action>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <local:IconButton Glyph="&#xE72C;" Text="Refresh" Click="Refresh_Click" ToolTipService.ToolTip="Read the branch again." />
                    <Button Content="Close" Click="Close_Click" ToolTipService.ToolTip="Back to where you came from." />
                </StackPanel>
            </local:EmptyState.Action>
        </local:EmptyState>

        <Grid x:Name="Filled" Grid.Row="1" RowDefinitions="Auto,*,Auto">
            <StackPanel Grid.Row="0" Spacing="8">
                <TextBlock x:Name="Header" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <InfoBar x:Name="WarnBar" Severity="Warning" IsClosable="False" IsOpen="False" />
            </StackPanel>

            <Grid x:Name="Body" Grid.Row="1" Padding="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftCol" Width="540" MinWidth="320" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <!-- The commits take the height they need, up to a cap; the files get the rest. -->
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="6">
                    <!-- Pick where the push stops. The list is newest first, so picking a line sends
                         everything from the snapshot up to it and leaves the lines above it behind. -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock x:Name="CommitsHeader" Text="Commits on the branch" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button x:Name="AllCommitsButton" Grid.Column="1" Content="Send all" Click="AllCommits_Click" FontSize="12" Padding="8,2" MinHeight="0"
                                ToolTipService.ToolTip="Go back to sending the whole branch in one push." />
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4" MaxHeight="260">
                        <Grid>
                            <local:RowListView x:Name="Commits" SelectionMode="Single" SelectionChanged="Commits_SelectionChanged"
                                               ItemTemplate="{StaticResource CommitRowTemplate}"
                                               ToolTipService.ToolTip="Pick the last commit this push should send. Everything under it goes with it; everything above it stays on the branch for the next push." />
                            <local:Skeleton x:Name="CommitsSkeleton" RowCount="4" Badges="False" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <InfoBar x:Name="PartialBar" Grid.Row="2" Severity="Informational" IsClosable="False" IsOpen="False" />
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,6,0,0">
                        <TextBlock x:Name="FilesHeader" Text="Files, one SVN commit per working copy" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBox x:Name="Filter" Grid.Column="1" PlaceholderText="Filter files  (Ctrl+F)" Visibility="Collapsed" FontSize="12" MinWidth="200"
                                 ToolTipService.ToolTip="Show only the rows whose status or path contains this text. It changes the list, never what gets pushed." />
                    </Grid>
                    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="4">
                        <Grid>
                            <!-- One root per working copy, the same cut the push commits in. -->
                            <local:RowTreeView x:Name="Files" ItemTemplate="{StaticResource FileTreeTemplate}" />
                            <local:Skeleton x:Name="FilesSkeleton" RowCount="8" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>

                <Thumb x:Name="Splitter" Grid.Column="1" Style="{StaticResource Splitter}" />

                <Border Grid.Column="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <local:DiffView x:Name="Diff" Margin="1" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Spacing="6">
                <!-- The six checks push runs before it writes anything, answered while you read the diff.
                     Passing is one line; failing names exactly what to fix. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="ChecksIcon" Glyph="&#xE73E;" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock x:Name="ChecksHeader" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"
                               ToolTipService.ToolTip="Push refuses on any of these. They are answered here so the refusal does not arrive half way through a four repository push." />
                </StackPanel>
                <ItemsControl x:Name="Checks" Margin="21,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <!-- A check that names something this page can solve carries the button for it,
                             so a blocked push is unblocked here instead of somewhere else. -->
                        <DataTemplate x:DataType="local:CheckRow">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                                <FontIcon Glyph="&#xEA39;" FontSize="11" VerticalAlignment="Center"
                                          Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <local:IconButton Grid.Column="3" Glyph="{x:Bind ActionGlyph}" Text="{x:Bind ActionText}"
                                                  Visibility="{x:Bind ActionVisibility}" Tag="{x:Bind}" Click="Fix_Click"
                                                  FontSize="12" Padding="8,2" MinHeight="0"
                                                  ToolTipService.ToolTip="{x:Bind ActionTip}" />
                                <local:IconButton Grid.Column="4" Glyph="{x:Bind SecondGlyph}" Text="{x:Bind SecondText}"
                                                  Visibility="{x:Bind SecondVisibility}" Tag="{x:Bind}" Click="Fix2_Click"
                                                  FontSize="12" Padding="8,2" MinHeight="0"
                                                  ToolTipService.ToolTip="{x:Bind SecondTip}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- The message is asked for on the press, in a dialog, not held open under the checks. -->
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                    <local:IconButton Glyph="&#xE72C;" Text="Refresh"
                        Click="Refresh_Click" ToolTipService.ToolTip="Read the branch again: commits, files, and the message." />
                    <Button Grid.Column="1" Content="Close" Click="Close_Click" ToolTipService.ToolTip="Back to where you came from. Nothing is sent." />
                    <!-- The same split the two commit pages have, and for the same reason: the left half is
                         what the window is for, and the right half is the other things to do with the very
                         same changes. Applying without committing is the way round a push when the change
                         wants reading first, and the shelf is where a change waits instead of going. -->
                    <local:AccentSplitButton Grid.Column="3" AutomationProperties.Name="Push to SVN" x:Name="PushButton"
                                             Click="Push_Click"
                                             ToolTipService.ToolTip="Write the message, then sync the checkout, rebase the branch, and make one svn commit per repository. Asks before it commits. Ctrl+Enter opens this too.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE898;" FontSize="14" />
                            <TextBlock Text="Push to SVN" />
                        </StackPanel>
                        <local:AccentSplitButton.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedRight">
                                <MenuFlyoutItem x:Name="ApplyItem" Text="Apply without committing" Click="Apply_Click"
                                                ToolTipService.ToolTip="Write the same changes into the checkout and stop there. Nothing goes to the server and the branch does not move: read them, change them, and commit them yourself from the changes window or from TortoiseSVN.">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8DE;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Shelved changes" Click="Shelf_Click"
                                                ToolTipService.ToolTip="What is already put aside from this branch, and the button that writes it back.">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE81C;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </local:AccentSplitButton.Flyout>
                    </local:AccentSplitButton>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- The message, asked for in a dialog over the middle of the window. Under it, where the push goes:
             one SVN commit per working copy, each under the message above until its switch is turned, then
             under a text of its own. Cancel keeps all of it for the next time. -->
        <local:MessageDialog x:Name="Message" Title="Push to SVN" PrimaryButtonText="Push to SVN"
                             Header="Commit message for SVN" CountTip="The server refuses a shorter message. The minimum is in Settings.">
            <local:MessageDialog.Extra>
                <StackPanel Spacing="6">
                    <TextBlock Text="One SVN commit in each of these" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                    <ItemsControl x:Name="Repos">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:PushRepoRow">
                                <StackPanel Spacing="4" Margin="0,2">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                        <Border CornerRadius="4" Padding="6,1" Background="{x:Bind RepoBackground}" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Repo}" Foreground="{x:Bind RepoBrush}" Style="{StaticResource RowText}" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{x:Bind FilesText}" Style="{StaticResource RowTextDim}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind CountText, Mode=OneWay}" Foreground="{x:Bind CountBrush, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        <ToggleSwitch Grid.Column="3" IsOn="{x:Bind Custom, Mode=TwoWay}" OnContent="Own message" OffContent="Own message" MinWidth="0" FontSize="12"
                                                      ToolTipService.ToolTip="Commit this working copy under a message of its own instead of the one above. It starts as a copy of it." />
                                    </Grid>
                                    <TextBox Text="{Binding Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{x:Bind CustomVisibility, Mode=OneWay}"
                                             MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </local:MessageDialog.Extra>
        </local:MessageDialog>

        <local:StatusStrip x:Name="Pane" Grid.Row="2" Margin="0,8,0,0" />
    </Grid>
</local:SgPage>
