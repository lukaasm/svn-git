<local:SgPage
    x:Class="Sg.App.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App">
    <!-- What is in an export file, and what putting it back here would mean, read before anything is
         written. The revisions are the point: the branch was cut from one set and this checkout is at
         another, so the page says which of them differ before it offers the button. -->
    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="8">

        <!-- An import that landed empties the page's question and leaves its answer here. -->
        <InfoBar x:Name="ResultBar" Grid.Row="0" Severity="Success" IsClosable="True" IsOpen="False" Margin="0,0,0,8" />

        <local:EmptyState x:Name="Unreadable" Grid.Row="1" Visibility="Collapsed" Glyph="&#xE7BA;" Title="This is not an sg export">
            <local:EmptyState.Action>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <local:IconButton Glyph="&#xED25;" Text="Pick another file" Click="Pick_Click" Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="Close" Click="Close_Click" ToolTipService.ToolTip="Back to where you came from." />
                </StackPanel>
            </local:EmptyState.Action>
        </local:EmptyState>

        <ScrollViewer x:Name="Filled" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8" MaxWidth="1000" Padding="0,0,0,8">

                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <FontIcon Glyph="&#xE8B7;" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="Headline" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="Provenance" Style="{StaticResource Secondary}" />
                            <TextBlock x:Name="FilePath" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Only when this checkout is not where the export was cut from. Every patch is merged across
                     the difference, which is worth knowing before the branch exists rather than after. -->
                <InfoBar x:Name="DriftBar" Severity="Warning" IsClosable="False" IsOpen="False"
                         Title="This checkout has moved on since the export" />

                <TextBlock Text="The revisions it was cut from" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                <Border Style="{StaticResource Card}" Padding="4">
                    <local:RowListView x:Name="Bases" SelectionMode="None">
                        <local:RowListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ImportBaseRow">
                                <Grid ColumnDefinitions="180,90,90,*" ColumnSpacing="{StaticResource RowSpacing}"
                                      ToolTipService.ToolTip="{x:Bind Url}">
                                    <TextBlock Text="{x:Bind Where}" Style="{StaticResource RowText}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Exported}" Style="{StaticResource RowMonoDim}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Local}" Style="{StaticResource RowMono}" Foreground="{x:Bind LocalBrush}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Shown}" Style="{StaticResource RowTextDim}" />
                                </Grid>
                            </DataTemplate>
                        </local:RowListView.ItemTemplate>
                    </local:RowListView>
                </Border>

                <TextBlock x:Name="CommitsHeader" Text="Commits" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                <Border Style="{StaticResource Card}" Padding="4">
                    <local:RowListView x:Name="Subjects" SelectionMode="None">
                        <local:RowListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource RowText}" />
                            </DataTemplate>
                        </local:RowListView.ItemTemplate>
                    </local:RowListView>
                </Border>

                <TextBlock x:Name="ConflictsHeader" Text="Files that need a hand" Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="0,6,0,0" Visibility="Collapsed" />
                <Border x:Name="ConflictsCard" Style="{StaticResource Card}" Padding="4" Visibility="Collapsed">
                    <local:RowListView x:Name="Conflicts" SelectionMode="None">
                        <local:RowListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource RowMono}" />
                            </DataTemplate>
                        </local:RowListView.ItemTemplate>
                    </local:RowListView>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,220,Auto" ColumnSpacing="8" Margin="0,4,0,0">
            <TextBlock Text="As branch" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Grid.Column="1" TextChanged="Name_TextChanged" MaxWidth="320" HorizontalAlignment="Left"
                     ToolTipService.ToolTip="The name the branch gets here. It starts as the name it had, which is free to be something else." />
            <TextBlock Grid.Column="2" Text="Into checkout" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <ComboBox x:Name="IntoBox" Grid.Column="3" HorizontalAlignment="Stretch" SelectionChanged="Into_Changed"
                      ToolTipService.ToolTip="The checkout the branch is built on. It should be one of the same SVN repository the export names." />
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
            <local:IconButton Glyph="&#xED25;" Text="Another file" Click="Pick_Click" ToolTipService.ToolTip="Read a different export file." />
            <Button Grid.Column="1" Content="Close" Click="Close_Click" ToolTipService.ToolTip="Back to where you came from. Nothing is written by leaving." />
            <!-- Only after an import stopped. It is the way on from there, so it stands next to the
                 sentence that says it stopped rather than somewhere the reader has to go and find. -->
            <local:IconButton Grid.Column="2" x:Name="ResolveButton" Glyph="&#xE8A5;" Text="Resolve conflicts" Visibility="Collapsed"
                              Style="{StaticResource AccentButtonStyle}" Click="Resolve_Click"
                              ToolTipService.ToolTip="Open the page that finishes it: pick a version per file, then continue. The commits after this one are still waiting behind it." />
            <TextBlock Grid.Column="3" x:Name="Summary" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="4" x:Name="ImportButton" Style="{StaticResource AccentButtonStyle}" Click="Import_Click"
                    AutomationProperties.Name="Import the branch"
                    ToolTipService.ToolTip="Make the branch and its worktree here, then replay every commit onto this checkout's snapshot.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                    <TextBlock x:Name="ImportLabel" Text="Import" />
                </StackPanel>
            </Button>
        </Grid>

        <local:StatusStrip x:Name="Pane" Grid.Row="4" Margin="0,8,0,0" />
    </Grid>
</local:SgPage>
