<local:SgPage
    x:Class="Sg.App.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App">
    <!-- What is in an export file, and what putting it back here would mean, read before anything is
         written. The revisions are the point: the branch was cut from one set and this checkout is at
         another, so the page says which of them differ before it offers the button. -->
    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="8">

        <!-- An import that landed empties the page's question and leaves its answer here. -->
        <InfoBar x:Name="ResultBar" Grid.Row="0" Severity="Success" IsClosable="True" IsOpen="False" Margin="0,0,0,8" />

        <local:EmptyState x:Name="Unreadable" Grid.Row="1" Visibility="Collapsed" Glyph="&#xE7BA;" Title="This is not an sg export">
            <local:EmptyState.Action>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <local:IconButton Glyph="&#xED25;" Text="Pick another file" Click="Pick_Click" Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="Close" Click="Close_Click" ToolTipService.ToolTip="Back to where you came from." />
                </StackPanel>
            </local:EmptyState.Action>
        </local:EmptyState>

        <local:ReadFeedback x:Name="ImportReading" Grid.Row="1" VerticalAlignment="Top" />
        <ScrollViewer x:Name="Filled" Grid.Row="1" MaxWidth="1000" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="8" Padding="0,0,0,8">

                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <FontIcon Glyph="&#xE8B7;" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="Headline" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="Provenance" Style="{StaticResource Secondary}" />
                            <TextBlock x:Name="FilePath" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <local:CheckoutAppearancePreview x:Name="AppearancePreview" />

                <local:RevisionComparison x:Name="RevisionPreview" />

                <TextBlock x:Name="CommitsHeader" Text="Commits" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                <Border Style="{StaticResource Card}" Padding="4">
                    <local:RowListView x:Name="Subjects" SelectionMode="None">
                        <local:RowListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource RowText}" />
                            </DataTemplate>
                        </local:RowListView.ItemTemplate>
                    </local:RowListView>
                </Border>

                <TextBlock x:Name="ConflictsHeader" Text="Files that need a hand" Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="0,6,0,0" Visibility="Collapsed" />
                <Border x:Name="ConflictsCard" Style="{StaticResource Card}" Padding="4" Visibility="Collapsed">
                    <local:RowListView x:Name="Conflicts" SelectionMode="None">
                        <local:RowListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource RowMono}" />
                            </DataTemplate>
                        </local:RowListView.ItemTemplate>
                    </local:RowListView>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" MaxWidth="1000" Spacing="8" Margin="0,4,0,0">
            <local:FormColumns>
                <StackPanel Spacing="4">
                    <TextBlock Text="Into checkout" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox x:Name="IntoBox" HorizontalAlignment="Stretch" SelectionChanged="Into_Changed"
                              AutomationProperties.Name="Into checkout"
                              ToolTipService.ToolTip="The destination checkout should belong to the same SVN repository as the saved branch." />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="As branch" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBox x:Name="NameBox" TextChanged="Name_TextChanged" AutomationProperties.Name="As branch"
                             ToolTipService.ToolTip="The name the branch and worktree get here. You can choose a different name." />
                </StackPanel>
            </local:FormColumns>
        </StackPanel>

        <StackPanel Grid.Row="3" MaxWidth="1000" Spacing="8" Margin="0,4,0,0">
            <TextBlock x:Name="Summary" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
            <local:DestinationAction x:Name="ExistingDestination" />
            <local:WrapRow Spacing="8">
                <local:IconButton x:Name="PickButton" Glyph="&#xED25;" Text="Another file" Click="Pick_Click" ToolTipService.ToolTip="Read a different export file." />
                <Button Content="Close" Click="Close_Click" ToolTipService.ToolTip="Back to where you came from. Nothing is written by leaving." />
                <!-- Only after an import stopped. It is the way on from there, so it stands next to the
                     sentence that says it stopped rather than somewhere the reader has to go and find. -->
                <local:IconButton x:Name="ResolveButton" Glyph="&#xE8A5;" Text="Resume import" Visibility="Collapsed"
                                  Style="{StaticResource AccentButtonStyle}" Click="Resolve_Click"
                                  ToolTipService.ToolTip="Open the page that finishes it: pick a version per file, then continue. The commits after this one are still waiting behind it." />
                <local:TaskGate>
                    <Button x:Name="ImportButton" Style="{StaticResource AccentButtonStyle}" Click="Import_Click"
                            AutomationProperties.Name="{Binding Text, ElementName=ImportLabel}"
                            ToolTipService.ToolTip="Make the branch and its worktree here, then replay every commit onto this checkout's snapshot.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                            <TextBlock x:Name="ImportLabel" Text="Import" />
                        </StackPanel>
                    </Button>
                </local:TaskGate>
            </local:WrapRow>
        </StackPanel>
        <local:StatusStrip x:Name="Pane" Grid.Row="4" Margin="0,8,0,0" />
    </Grid>
</local:SgPage>
