<Window
    x:Class="Sg.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App"
    Title="sg">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <!-- Anything dropped on the window from Explorer: a folder is a working copy to add, an export file
         is a branch to import. The caption under the pointer says which before the drop. -->
    <Grid RowDefinitions="Auto,*" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
        <TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="sg" Subtitle="" />

        <!-- The shape of Windows Settings: checkouts in the pane, a back button over it, and on the
             right the path to the page on screen, the page, and nothing else. -->
        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="260"
                        IsBackButtonVisible="Visible" IsBackEnabled="False" BackRequested="Nav_BackRequested"
                        IsSettingsVisible="True" SelectionChanged="Nav_SelectionChanged"
                        ItemInvoked="Nav_ItemInvoked">
            <!-- The pane title row, with the two ways to add a checkout on its right. Opening or making a
                 root is done once, so both wait behind the dots while a root is open. -->
            <NavigationView.PaneHeader>
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="0,0,4,0">
                    <TextBlock Text="Checkouts" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                    <!-- Registering a working copy that is already on disk. Without it the only ways in
                         were making a root or copying one on the server, so a root looked like it held one. -->
                    <Border x:Name="AddCheckoutTip" Grid.Column="1" Background="Transparent">
                        <Button x:Name="AddCheckoutButton" Click="AddCheckout_Click" Style="{StaticResource QuietButton}"
                                AutomationProperties.Name="Add checkout">
                            <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                        </Button>
                    </Border>
                    <Border x:Name="ServerCheckoutTip" Grid.Column="2" Background="Transparent">
                        <Button x:Name="ServerCheckoutButton" Click="ServerCheckout_Click" Style="{StaticResource QuietButton}"
                                AutomationProperties.Name="New server checkout">
                            <FontIcon Glyph="&#xE710;" FontSize="16" />
                        </Button>
                    </Border>
                    <Button x:Name="RootMenu" Grid.Column="3" Style="{StaticResource QuietButton}"
                            AutomationProperties.Name="More" ToolTipService.ToolTip="More: open another root, or make a new one.">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                        <Button.Flyout>
                            <!-- The roots opened before follow these two, filled in when the menu opens. -->
                            <MenuFlyout x:Name="RootFlyout" Placement="Bottom" Opening="RootFlyout_Opening">
                                <MenuFlyoutItem Text="Open root" Click="OpenRoot_Click"
                                                ToolTipService.ToolTip="Pick a folder that already holds .sg.">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED25;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="New root" Click="NewRoot_Click"
                                                ToolTipService.ToolTip="Runs sg init on a folder, then offers to register the first SVN checkout.">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </NavigationView.PaneHeader>

            <!-- An empty pane says why, where the checkouts would be, and offers the two ways to fill it. -->
            <NavigationView.PaneCustomContent>
                <local:EmptyState x:Name="PaneEmpty" Visibility="Collapsed" Glyph="&#xED25;" Title="No root open" Padding="8,24"
                                  Text="A root is the folder that holds .sg and your checkouts.">
                    <local:EmptyState.Action>
                        <StackPanel Spacing="8">
                            <local:IconButton Glyph="&#xED25;" Text="Open root" Click="OpenRoot_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="Pick a folder that already holds .sg." />
                            <local:IconButton Glyph="&#xE8F4;" Text="New root" Click="NewRoot_Click" HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="Runs sg init on a folder, then offers to register the first SVN checkout." />
                            <!-- The roots opened before, one button each, so the way back into one is one press. -->
                            <StackPanel x:Name="RecentRoots" Spacing="4" Margin="0,8,0,0" />
                        </StackPanel>
                    </local:EmptyState.Action>
                </local:EmptyState>
            </NavigationView.PaneCustomContent>

            <!-- Footer items sit directly above the Settings entry. -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="MonitorItem"
                                    AutomationProperties.Name="Project monitor"
                                    ToolTipService.ToolTip="Project monitor: watch any SVN URLs in categories, get a toast on new commits, and preview them.">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BA;" />
                    </NavigationViewItem.Icon>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="Project monitor" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <local:StatusChip x:Name="MonitorChip" Grid.Column="1" Severity="Attention" Glyph="&#xE7E7;" Visibility="Collapsed" />
                    </Grid>
                    <!-- A collapsed pane hides the row content, and only the platform's own badge is left. -->
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="MonitorBadge" Style="{StaticResource AttentionValueInfoBadgeStyle}" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <!-- Recoloured through the item's own resources, so it keeps the exact row shape
                     and icon alignment of the Settings entry below it. -->
                <NavigationViewItem x:Name="UpdateItem" Content="Update and restart" Visibility="Collapsed"
                                    SelectsOnInvoked="False" FontWeight="SemiBold"
                                    AutomationProperties.Name="Update and restart">
                    <NavigationViewItem.Resources>
                        <StaticResource x:Key="NavigationViewItemBackground" ResourceKey="AccentFillColorDefaultBrush" />
                        <StaticResource x:Key="NavigationViewItemBackgroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                        <StaticResource x:Key="NavigationViewItemBackgroundPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                        <StaticResource x:Key="NavigationViewItemForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                        <StaticResource x:Key="NavigationViewItemForegroundPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                        <StaticResource x:Key="NavigationViewItemForegroundPressed" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                    </NavigationViewItem.Resources>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE898;" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid RowDefinitions="Auto,*" Padding="24,0,24,16">
                <!-- The path to the page, written large the way Windows Settings writes "System > Display",
                     with the forward arrow beside it when there is somewhere forward to go. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,6,0,12">
                    <StackPanel Spacing="2">
                        <BreadcrumbBar x:Name="Crumbs" ItemClicked="Crumbs_ItemClicked">
                            <BreadcrumbBar.ItemTemplate>
                                <DataTemplate x:DataType="local:Crumb">
                                    <TextBlock Text="{x:Bind Text}" FontSize="26" FontWeight="SemiBold" Foreground="{x:Bind Brush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                </DataTemplate>
                            </BreadcrumbBar.ItemTemplate>
                        </BreadcrumbBar>
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- Beside the path rather than on the checkout's own toolbar: reading everything again
                         is about the root, not about the page you happen to be on, and F5 already did it
                         from anywhere. It is here whenever a root is open, which is whenever it can work. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                        <Button x:Name="RefreshButton" Visibility="Collapsed" Click="RefreshAll_Click"
                                Style="{StaticResource QuietButton}"
                                AutomationProperties.Name="Refresh"
                                ToolTipService.ToolTip="Read the state of every checkout and worktree again, and ask the server for new commits. F5 does the same.">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        </Button>
                        <Button x:Name="ForwardButton" Visibility="Collapsed" Click="Forward_Click"
                                Style="{StaticResource QuietButton}"
                                AutomationProperties.Name="Forward" ToolTipService.ToolTip="Forward (Alt+Right)">
                            <FontIcon Glyph="&#xE72A;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>

                <local:NavHost x:Name="Host" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
