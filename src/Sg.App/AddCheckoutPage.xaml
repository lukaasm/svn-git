<local:SgPage
    x:Class="Sg.App.AddCheckoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App">
    <Grid RowDefinitions="*,Auto,Auto" RowSpacing="8">
        <ScrollViewer Grid.Row="0" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" MaxWidth="1000" Padding="0,0,0,16">
                <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap"
                           Text="Adds a checkout to the open root: an SVN working copy or a git clone that already exists on disk, or one checked out or cloned from a URL first. It joins the checkouts in the pane, shares the one git store, and gets its own snapshot ref. 'New server checkout' is the faster way to another branch of a checkout you already have: it copies that one and switches." />

                <Border Style="{StaticResource Card}">
                    <local:CheckoutFields x:Name="Fields" />
                </Border>

                <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap"
                           Text="An SVN working copy gets one file: .git, a one-line pointer back to the root, and every versioned file is hashed once, which on a 16 GB checkout takes minutes. A git clone keeps its own .git; the branch's history is copied into the store once. The server never sees any of it." />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <local:TaskGate>
                <local:IconButton Glyph="&#xE896;" Text="Add the checkout"
                    x:Name="AddButton" Style="{StaticResource AccentButtonStyle}" Click="Add_Click" IsEnabled="False"
                    ToolTipService.ToolTip="Same as 'sg checkout add'. From a URL, svn checkout or git clone runs first. Then the first snapshot is taken, which is the long step." />
            </local:TaskGate>
            <Button x:Name="CloseButton" Content="Close" Click="Close_Click"
                    ToolTipService.ToolTip="Back to the overview. Nothing is registered unless you added it." />
            <TextBlock x:Name="Result" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <local:StatusStrip x:Name="Pane" Grid.Row="2" />
    </Grid>
</local:SgPage>
