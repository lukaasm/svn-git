<local:SgPage
    x:Class="Sg.App.CommitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Above both states: a commit that just went through empties the page, and its result must outlive that. -->
        <StackPanel Spacing="8" Margin="0,0,0,8">
            <InfoBar x:Name="ResultBar" Severity="Success" IsClosable="True" IsOpen="False" />
            <InfoBar x:Name="DraftNotice" Severity="Warning" IsClosable="True" IsOpen="False" />
        </StackPanel>

        <!-- A clean worktree has no list to pick from, no diff to read and no message to write, so none of
             that is on screen: the page is the one sentence, and the two buttons that still mean something. -->
        <local:EmptyState x:Name="NoChanges" Grid.Row="1" Visibility="Collapsed" Glyph="&#xE73E;" Title="Nothing to commit"
                          Text="Every file in the worktree matches the last commit. Edit something here, or let an agent, and it shows up on this page.">
            <local:EmptyState.Action>
                <local:WrapRow Spacing="8">
                    <local:IconButton Glyph="&#xE72C;" Text="Refresh" Click="Refresh_Click" ToolTipService.ToolTip="Read the changes in the worktree again. F5 does the same." />
                    <local:IconButton x:Name="CleanShelfButton" Glyph="&#xE7B8;" Text="Shelved changes" Click="Shelf_Click" Visibility="Collapsed"
                                      ToolTipService.ToolTip="Changes put aside from this branch. The worktree is clean because they are waiting here." />
                    <!-- The only way in to a message-only amend: with nothing changed, the page below is not on screen. -->
                    <local:IconButton x:Name="AmendFromEmpty" Glyph="&#xE70F;" Text="Reword the last commit" Click="AmendFromEmpty_Click"
                                      ToolTipService.ToolTip="Replace the last commit with one that has the same files and a new message. Only for a commit that has not been pushed." />
                    <Button Content="Close" Click="Close_Click" ToolTipService.ToolTip="Back to where you came from." />
                </local:WrapRow>
            </local:EmptyState.Action>
        </local:EmptyState>

        <Grid x:Name="Filled" Grid.Row="1" RowDefinitions="Auto,*,Auto" RowSpacing="8">
            <StackPanel Spacing="8">
                <InfoBar x:Name="AmendNotice" Severity="Informational" IsClosable="False" IsOpen="False"
                         Message="This will replace the last local commit.">
                    <InfoBar.ActionButton><Button Content="Cancel amend" Click="CancelAmend_Click" /></InfoBar.ActionButton>
                </InfoBar>
                <SelectorBar x:Name="CompactViews" Visibility="Collapsed" AutomationProperties.Name="Review view">
                    <SelectorBarItem x:Name="ChangesTab" Text="Changes">
                        <SelectorBarItem.Icon><FontIcon Glyph="&#xE8FD;" /></SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Name="DiffTab" Text="Diff">
                        <SelectorBarItem.Icon><FontIcon Glyph="&#xE8A5;" /></SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>
            </StackPanel>
            <Grid x:Name="Body" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftCol" Width="560" MinWidth="320" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="ChangesPane" Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="6">
                    <!-- The filter has a row of its own so it fits narrow panes. -->
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock x:Name="FilesHeader" Text="Changes" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <!-- One box for every row: ticked when they all are, half when some are. -->
                            <CheckBox x:Name="AllCheck" Grid.Column="1" Content="All" MinWidth="0" Click="All_Click"
                                      ToolTipService.ToolTip="Check every change, untracked files too. With every change checked, this unchecks them all." />
                        </Grid>
                        <TextBox x:Name="Filter" PlaceholderText="Filter files  (Ctrl+F)" Visibility="Collapsed" FontSize="12"
                                 ToolTipService.ToolTip="Show only the rows whose status or path contains this text. It changes the list, never what is checked or discarded." />
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                        <Grid>
                            <local:RowTreeView x:Name="Files" ItemTemplate="{StaticResource CheckedFileTreeTemplate}" />
                            <local:Skeleton x:Name="FilesSkeleton" RowCount="8" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>

                <Thumb x:Name="Splitter" Grid.Column="1" Style="{StaticResource Splitter}" />

                <Border x:Name="DiffPane" Grid.Column="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <local:DiffView x:Name="Diff" Margin="1" />
                </Border>
            </Grid>

            <!-- The message is asked for on the press, in a dialog, not held open under the list: the list and the diff are
                 what the page is for, and the box would sit empty through all of the reading. -->
            <StackPanel Grid.Row="2" Spacing="8">
                <TextBlock x:Name="Summary" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                <local:WrapRow Spacing="8">
                <local:TaskGate>
                    <!-- Its menu holds the other two ends of the same decision about the checked files:
                         put them aside, or throw them away. -->
                    <local:AccentSplitButton AutomationProperties.Name="Commit" x:Name="CommitButton" IsEnabled="False"
                                             Click="Commit_Click"
                                             ToolTipService.ToolTip="Write the message, then commit the checked files to the git branch under your own git identity. Nothing goes to SVN. Ctrl+Enter opens this too.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                            <TextBlock x:Name="CommitLabel" Text="Commit" />
                        </StackPanel>
                        <local:AccentSplitButton.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedRight" local:MenuGate.Watch="True">
                                <MenuFlyoutItem x:Name="ShelveButton" Text="Shelve them instead" Click="Shelve_Click" local:MenuGate.Gated="True">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B8;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="DiscardButton" Text="Discard them…" Click="Discard_Click" local:MenuGate.Gated="True">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </local:AccentSplitButton.Flyout>
                    </local:AccentSplitButton>
                </local:TaskGate>
                <!-- Amend sits under More and not in the menu of Commit: a message-only amend has nothing
                     checked, and with nothing checked Commit, menu and all, is off. -->
                <CommandBar x:Name="Actions" DefaultLabelPosition="Right" Background="Transparent" HorizontalAlignment="Left" Margin="-8,0,0,0"
                            local:MenuGate.Watch="True">
                    <AppBarButton x:Name="RefreshButton" Label="Refresh" Click="Refresh_Click"
                                  ToolTipService.ToolTip="Read the changes in the worktree again. F5 does the same.">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <CommandBar.SecondaryCommands>
                        <AppBarButton x:Name="StageButton" Label="Stage checked files" Click="Stage_Click" local:MenuGate.Gated="True">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="UnstageButton" Label="Unstage checked files" Click="Unstage_Click" local:MenuGate.Gated="True">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE738;" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarToggleButton x:Name="Amend" Label="Amend the last commit" Click="Amend_Click">
                            <AppBarToggleButton.Icon><FontIcon Glyph="&#xE70F;" /></AppBarToggleButton.Icon>
                        </AppBarToggleButton>
                        <AppBarSeparator />
                        <AppBarButton x:Name="ShelfButton" Label="Shelved changes" Click="Shelf_Click"
                                      ToolTipService.ToolTip="Review the changes already put aside from this branch.">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE7B8;" /></AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.SecondaryCommands>
                </CommandBar>
                </local:WrapRow>
            </StackPanel>
        </Grid>

        <!-- The message, asked for in a dialog over the middle of the window. Cancel keeps the text for the next time. -->
        <local:MessageDialog x:Name="Message" Title="Commit" PrimaryButtonText="Commit" Minimum="1"
                             Header="Commit message" CountTip="A git commit needs a message. Nothing here reaches SVN." />

        <local:StatusStrip x:Name="Pane" Grid.Row="2" Margin="0,8,0,0" />
    </Grid>
</local:SgPage>
