<UserControl
    x:Class="Sg.App.CheckoutAppearancePreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App"
    Visibility="Collapsed" HorizontalContentAlignment="Stretch">
    <Border Style="{StaticResource Card}">
        <StackPanel Spacing="12">
            <local:WrapRow Spacing="16">
                <TextBlock Text="Checkout icon" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <local:StatusChip x:Name="Outcome" />
            </local:WrapRow>
            <local:WrapRow Spacing="32" LineSpacing="12">
                <Grid ColumnDefinitions="48,*" ColumnSpacing="12" MaxWidth="340">
                    <Viewbox x:Name="CurrentImage" Width="40" Height="40" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="CurrentName" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="CurrentKind" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="48,*" ColumnSpacing="12" MaxWidth="340">
                    <Viewbox x:Name="SavedImage" Width="40" Height="40" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Saved" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="SavedKind" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </local:WrapRow>
            <TextBlock x:Name="AppearanceNote" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
