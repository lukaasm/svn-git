<local:SgPage
    x:Class="Sg.App.BlamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App">
    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <InfoBar x:Name="WarnBar" Grid.Row="0" Severity="Warning" IsClosable="False" IsOpen="False" Margin="0,0,0,8" />

        <local:EmptyState x:Name="Nothing" Grid.Row="1" Visibility="Collapsed" Glyph="&#xE81C;" Title="Nothing to blame"
                          Text="This file has no lines, or nothing that knows about them.">
            <local:EmptyState.Action>
                <Button Content="Close" Click="Close_Click" ToolTipService.ToolTip="Back to where you came from." />
            </local:EmptyState.Action>
        </local:EmptyState>

        <Grid x:Name="Filled" Grid.Row="1" RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                <TextBlock x:Name="Header" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBox x:Name="Filter" Grid.Column="1" PlaceholderText="Filter lines  (Ctrl+F)" Visibility="Collapsed" FontSize="12" MinWidth="220"
                         ToolTipService.ToolTip="Show only the lines whose text, author or revision contains this. It never changes the file." />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftCol" Width="*" MinWidth="420" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="420" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="4">
                    <Grid>
                        <local:RowListView x:Name="Lines" SelectionChanged="Lines_SelectionChanged" ItemTemplate="{StaticResource BlameRowTemplate}"
                                           ToolTipService.ToolTip="Pick a line to see what its revision changed, and what its message said." />
                        <local:Skeleton x:Name="LinesSkeleton" RowCount="12" Badges="False" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Thumb x:Name="Splitter" Grid.Column="1" Style="{StaticResource Splitter}" />

                <!-- What the picked line's revision was: who, when, what it said, and what it changed here. -->
                <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="6">
                    <TextBlock Text="The change that put that line there" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,8" MaxHeight="220">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="DetailHead" Style="{StaticResource Secondary}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailMessage" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Grid.Row="2" Text="What it changed in this file" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                    <Border Grid.Row="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <local:DiffView x:Name="Diff" Margin="1" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Margin="0,8,0,0">
            <local:IconButton Glyph="&#xE72C;" Text="Refresh" Click="Refresh_Click" ToolTipService.ToolTip="Blame the file again. F5 does the same." />
            <Button Grid.Column="1" Content="Close" Click="Close_Click" ToolTipService.ToolTip="Back to where you came from." />
            <TextBlock Grid.Column="2" x:Name="Summary" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>

        <local:StatusStrip x:Name="Pane" Grid.Row="3" Margin="0,8,0,0" />
    </Grid>
</local:SgPage>
