<local:SgPage x:Class="Sg.App.BackupComparePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App">
    <local:SgPage.Resources>
        <DataTemplate x:Key="HistoryCommit" x:DataType="local:CommitRow">
            <StackPanel Spacing="2" Padding="4" ToolTipService.ToolTip="{x:Bind Tip}">
                <TextBlock Text="{x:Bind Subject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <TextBlock Text="{x:Bind Date}" Style="{StaticResource Secondary}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Author}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </local:SgPage.Resources>
    <Grid RowDefinitions="Auto,Auto,*,2*,Auto" RowSpacing="8">
        <StackPanel Spacing="8">
            <local:ReportCard x:Name="ComparisonReading" AutomationProperties.AutomationId="BackupCompareLoading" />
            <InfoBar x:Name="ReadError" IsOpen="False" IsClosable="False" Severity="Error" Title="Could not compare this backup">
                <local:IconButton Text="Refresh comparison" Glyph="&#xE72C;" Click="Refresh_Click" AutomationProperties.AutomationId="BackupCompareRetry" />
            </InfoBar>
            <TextBlock x:Name="ComparedAt" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="Search" PlaceholderText="Search both histories by message, author, date, or commit"
                     AutomationProperties.AutomationId="BackupCompareSearch" AutomationProperties.Name="Search both commit histories" />
            <local:IconButton Grid.Column="1" Text="Refresh" Glyph="&#xE72C;" Click="Refresh_Click" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8" MinHeight="150">
            <Border Style="{StaticResource Card}" Padding="12">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                    <local:StatusChip x:Name="LocalHeader" Glyph="&#xE8B7;" Text="Local history" Severity="Attention" />
                    <TextBlock x:Name="LocalBase" Grid.Row="1" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    <Grid Grid.Row="2">
                        <local:RowListView x:Name="LocalCommits" AutomationProperties.AutomationId="BackupCompareLocal" SelectionMode="Single"
                                           ItemTemplate="{StaticResource HistoryCommit}" SelectionChanged="Commit_Changed" />
                        <TextBlock x:Name="LocalEmpty" Style="{StaticResource Secondary}" TextWrapping="Wrap" Visibility="Collapsed" />
                        <local:Skeleton x:Name="LocalLoading" RowCount="3" Badges="False" />
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                    <local:StatusChip x:Name="RemoteHeader" Glyph="&#xE753;" Text="Backup history" />
                    <TextBlock x:Name="RemoteBase" Grid.Row="1" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    <Grid Grid.Row="2">
                        <local:RowListView x:Name="RemoteCommits" AutomationProperties.AutomationId="BackupCompareRemote" SelectionMode="Single"
                                           ItemTemplate="{StaticResource HistoryCommit}" SelectionChanged="Commit_Changed" />
                        <TextBlock x:Name="RemoteEmpty" Style="{StaticResource Secondary}" TextWrapping="Wrap" Visibility="Collapsed" />
                        <local:Skeleton x:Name="RemoteLoading" RowCount="3" Badges="False" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="6">
            <TextBlock x:Name="PatchTitle" Text="Select a commit to inspect its changes" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <ContentControl x:Name="DiffHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    <local:EmptyState x:Name="ChooseCommit" Glyph="&#xE8A5;" Title="Compare the histories above"
                                      Text="Select a commit on either side to review its patch. Different commit IDs can represent the same work after a restore or replay." />
                    <local:Skeleton x:Name="PatchLoading" RowCount="5" Badges="False" Visibility="Collapsed" />
                    <InfoBar x:Name="PatchError" IsOpen="False" IsClosable="False" Severity="Error" VerticalAlignment="Top">
                        <local:IconButton Text="Retry patch" Glyph="&#xE72C;" Click="RetryPatch_Click" />
                    </InfoBar>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="4" Spacing="8">
            <local:WrapRow Spacing="12">
                <HyperlinkButton x:Name="LocalHistory" Click="LocalHistory_Click" IsEnabled="False" AutomationProperties.Name="Local history">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE81C;" FontSize="14" /><TextBlock Text="Local history" /></StackPanel>
                </HyperlinkButton>
                <HyperlinkButton Click="Restore_Click" AutomationProperties.Name="Restore options">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE896;" FontSize="14" /><TextBlock Text="Restore options" /></StackPanel>
                </HyperlinkButton>
                <TextBlock Text="Committed changes only · saved edits and shelves are managed separately" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </local:WrapRow>
            <local:StatusStrip x:Name="Pane" />
        </StackPanel>
    </Grid>
</local:SgPage>
