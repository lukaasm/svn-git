<local:SgPage
    x:Class="Sg.App.ConflictPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sg.App">
    <!-- A stop is three decisions: which version of each file, then go on, or drop this commit, or put
         it all back. The page is built the way the Commit and Merge pages are - files on the left, the
         diff on the right, one row of actions under both - and says each fact once: the banner what
         stopped and where, each file's row how it conflicts, the diff what differs. -->
    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">

        <InfoBar x:Name="StateBar" Grid.Row="0" Severity="Warning" IsClosable="False" IsOpen="True" />

        <!-- No file in conflict means no list, no sides to pick and no diff: the page is the one
             sentence about what stopped, and the buttons that move it on. -->
        <local:EmptyState x:Name="NoConflicts" Grid.Row="1" Visibility="Collapsed" Glyph="&#xE73E;" Title="Nothing in conflict" />

        <Grid x:Name="Filled" Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="8">
            <SelectorBar x:Name="CompactViews" Visibility="Collapsed" AutomationProperties.Name="Resolve view">
                <SelectorBarItem x:Name="FilesTab" Text="Files">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE8FD;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="DiffTab" Text="Diff">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE8A5;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>

            <Grid x:Name="Body" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftCol" Width="520" MinWidth="320" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="FilesPane" Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="6">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="FilesHeader" Text="Conflicts" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBox x:Name="Filter" PlaceholderText="Filter files  (Ctrl+F)" Visibility="Collapsed" FontSize="12"
                                 ToolTipService.ToolTip="Show only the rows whose path contains this text." />
                    </StackPanel>
                    <!-- The words VS Code and the git tools use. Which versions current and incoming are
                         depends on what stopped, so the tooltips are written from the page. The row
                         wraps rather than cutting a button in half in a narrow column. -->
                    <local:WrapRow Grid.Row="1" Spacing="6" LineSpacing="6">
                        <local:TaskGate>
                            <local:IconButton x:Name="TakeOurs" Glyph="&#xE753;" Text="Accept current" Click="TakeOurs_Click" />
                        </local:TaskGate>
                        <local:TaskGate>
                            <local:IconButton x:Name="TakeTheirs" Glyph="&#xE8A5;" Text="Accept incoming" Click="TakeTheirs_Click" />
                        </local:TaskGate>
                        <local:IconButton Glyph="&#xE70F;" Text="Open in editor" Click="OpenFile_Click"
                            ToolTipService.ToolTip="Open the ticked files, or the one selected, in their default editor. Each holds both versions between conflict markers: edit it, save, then mark it resolved." />
                        <local:TaskGate>
                            <local:IconButton Glyph="&#xE73E;" Text="Mark as resolved" Click="MarkResolved_Click"
                                ToolTipService.ToolTip="Tell git the ticked files, or the one selected, are done, after you edited them." />
                        </local:TaskGate>
                        <local:TaskGate>
                            <local:IconButton x:Name="AutoButton" Glyph="&#xE945;" Text="Resolve with AI" Click="Auto_Click"
                                ToolTipService.ToolTip="Hand the ticked files, or every file in conflict, to the resolver: Claude Code, unless Settings names another command. It edits them in place, keeping both sides' changes. What comes back whole is marked resolved and stays here to read before you continue." />
                        </local:TaskGate>
                    </local:WrapRow>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
                        <Grid>
                            <!-- Tick the files a side applies to, or just select the one you are reading.
                                 Each row says how it conflicts, in git's own words, on its right. -->
                            <local:RowTreeView x:Name="Files" ItemTemplate="{StaticResource CheckedFileTreeTemplate}" />
                            <local:Skeleton x:Name="FilesSkeleton" RowCount="5" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>

                <Thumb x:Name="Splitter" Grid.Column="1" Style="{StaticResource Splitter}" />

                <Grid x:Name="DiffPane" Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="6">
                    <!-- Current against incoming says what differs. The other two show each side against
                         the version both started from, which is what a hand needs before it carries one
                         change over onto the other. -->
                    <ComboBox x:Name="Compare" MinWidth="300" SelectedIndex="0" SelectionChanged="Compare_Changed" FontSize="12"
                              AutomationProperties.Name="Compare"
                              ToolTipService.ToolTip="Which two versions of the selected file the diff shows." />
                    <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <local:DiffView x:Name="Diff" Margin="1" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- The commit being replayed, or what is staged for it so far: read-only, over the files and
             the diff, until Back to conflicts. -->
        <local:DiffView x:Name="PatchPreview" Grid.Row="1" Visibility="Collapsed" />

        <!-- Continue first and accented, as every page puts its one thing to do; Skip and Abort next,
             the other two ways out; what is only ever looked at, in More; Close last. -->
        <local:WrapRow x:Name="Actions" Grid.Row="2" Spacing="8" LineSpacing="6">
            <local:TaskGate>
                <local:IconButton x:Name="ContinueButton" Glyph="&#xE768;" Text="Continue"
                    Style="{StaticResource AccentButtonStyle}" Click="Continue_Click" />
            </local:TaskGate>
            <local:IconButton x:Name="BackToConflicts" Glyph="&#xE72B;" Text="Back to conflicts" Visibility="Collapsed" Click="BackToConflicts_Click" />
            <local:IconButton x:Name="ReviewEditsButton" Glyph="&#xE7B8;" Text="Review local edits" Visibility="Collapsed" Click="ReviewEdits_Click" />
            <local:TaskGate>
                <local:IconButton x:Name="SkipButton" Glyph="&#xE72A;" Text="Skip commit" Click="Skip_Click" />
            </local:TaskGate>
            <local:TaskGate>
                <local:IconButton x:Name="AbortButton" Glyph="&#xE711;" Text="Abort" Click="Abort_Click" />
            </local:TaskGate>
            <local:IconButton x:Name="MoreButton" Glyph="&#xE712;" Text="More" AutomationProperties.Name="More actions">
                <Button.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedLeft">
                        <MenuFlyoutItem x:Name="InspectButton" Text="View commit" Click="Inspect_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ReviewResultButton" Text="Review staged changes" Click="ReviewResult_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="AutoAllButton" Text="Resolve remaining commits with AI…" Click="AutoAll_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE945;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ForceButton" Text="Apply patch manually…" Visibility="Collapsed" Click="Force_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Refresh" Click="Refresh_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </local:IconButton>
            <Button x:Name="LeaveButton" Content="Close" Click="Close_Click" />
        </local:WrapRow>

        <local:StatusStrip x:Name="Pane" Grid.Row="3" />
    </Grid>
</local:SgPage>
